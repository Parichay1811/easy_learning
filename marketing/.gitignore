# Tooling (re-created by `npm install` and the venv step in README)
node_modules/
.venv/
__pycache__/

# HyperFrames working files (snapshots, check reports)
.hyperframes/

# Rendered output (videos, thumbnails, captions, upload copies) is re-created by tools/render.sh: never committed.
renders/

# Per-line voice clips are a cache; vo.wav (the mixed track) is kept so videos render without the TTS model
assets/voice/*/*.wav
!assets/voice/*/vo.wav
assets/voice/*/cache.json
linkedin-carousels/.*.png
