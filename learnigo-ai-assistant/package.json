{
  "name": "learnigo-live-teacher",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "A live, voice-driven teacher website: speech in and out on the CPU, answers from checked lesson packs",
  "license": "MIT",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test test/*.test.mjs",
    "bench": "node bench.mjs",
    "eval": "node eval-kb.mjs",
    "packs": "node factory/build-packs.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "3.8.1",
    "gsap": "3.13.0",
    "node-llama-cpp": "^3.22.2",
    "onnxruntime-node": "1.21.0",
    "world-atlas": "^2.0.2",
    "yt-search-lib": "^1.3.0"
  },
  "optionalDependencies": {
    "kokoro-js": "1.2.1"
  }
}
