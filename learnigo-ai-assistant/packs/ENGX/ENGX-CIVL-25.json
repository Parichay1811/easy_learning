  "faq": [
    {
      "q": "How does a tunnel boring machine work?",
      "a": "A rotating cutterhead grinds away rock or soil at the front, thrust rams push it forward, conveyors carry the spoil away, and a robot arm lines the tunnel with concrete rings behind it.",
      "asks": [
        "What is a TBM?",
        "How do tunnel machines dig?"
      ]
    },
    {
      "q": "What is the cutterhead?",
      "a": "The cutterhead is the giant spinning wheel at the front, fitted with steel disc cutters for rock or scraping teeth for soil. As it turns and is pushed forward, it breaks the ground into small pieces.",
      "asks": [
        "What does the front of a TBM do?"
      ]
    },
    {
      "q": "How does a TBM move forward?",
      "a": "Hydraulic rams around the machine push against the last concrete ring that was built. As they extend, the whole machine moves forward; then they pull back and a new ring is built.",
      "asks": [
        "What pushes a tunnel boring machine?"
      ]
    },
    {
      "q": "What are tunnel lining rings?",
      "a": "They are rings made of curved precast concrete pieces called segments, bolted together right behind the cutterhead. They support the ground and keep water out.",
      "asks": [
        "How is the tunnel wall made?",
        "What are tunnel segments?"
      ]
    },
    {
      "q": "What happens to the soil a TBM digs?",
      "a": "It passes through the cutterhead into a chamber, then screw conveyors and belts, or slurry pipes, carry it back through the tunnel and up to the surface.",
      "asks": [
        "Where does the dirt go when tunnelling?"
      ]
    }
  ],
  "facts": [
    "Large tunnel boring machines can exceed 15 metres in diameter; Bertha, which dug Seattle's SR 99 tunnel, was about 17.5 metres across.",
    "A tunnel boring machine lines the tunnel with rings of precast concrete segments as it advances."
  ],
