  "faq": [
    {
      "q": "Why is a flywheel heavy?",
      "a": "The energy a flywheel stores grows with its mass, especially mass near the rim. A heavy rim makes it resist changes in speed, so it keeps turning steadily.",
      "asks": [
        "Why do flywheels have heavy rims?"
      ]
    },
    {
      "q": "How does a flywheel store energy?",
      "a": "As kinetic energy of spinning. It soaks up energy when pushed and gives it back when the push stops. The energy grows with the square of the speed.",
      "asks": [
        "What energy does a flywheel store?"
      ]
    },
    {
      "q": "What does a flywheel do in an engine?",
      "a": "It carries the crankshaft round between the power strokes, so the engine runs smoothly instead of jerking, and keeps it turning at low speed.",
      "asks": [
        "Why do engines need a flywheel?"
      ]
    },
    {
      "q": "Where are flywheels used?",
      "a": "In engines, potter's wheels, old sewing machines, exercise bikes, friction-powered toy cars and even some power stations that use giant flywheels to store energy for short bursts.",
      "asks": [
        "What uses a flywheel?"
      ]
    },
    {
      "q": "How does a friction toy car keep going?",
      "a": "Pushing the car along the floor spins a small heavy flywheel through gears. When you let go, the flywheel keeps spinning and drives the wheels.",
      "asks": [
        "How does a push and go car work?"
      ]
    }
  ],
  "facts": [
    "A flywheel's stored energy grows with the square of its spinning speed.",
    "Putting mass near the rim stores more energy than the same mass near the centre."
  ],
