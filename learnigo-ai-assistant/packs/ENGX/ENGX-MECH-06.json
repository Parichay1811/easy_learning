  "faq": [
    {
      "q": "What is a cam?",
      "a": "A cam is a wheel with a special outline, mounted on a rotating shaft. Because its edge is not the same distance from the centre all the way round, it pushes anything resting on it up and down.",
      "asks": [
        "What does a cam do?"
      ]
    },
    {
      "q": "What is a follower?",
      "a": "The follower is the rod that rests on the cam and follows its outline. It slides up and down in a guide, copying the shape of the cam as it turns.",
      "asks": [
        "What does the follower do?"
      ]
    },
    {
      "q": "What do the different cam shapes do?",
      "a": "A pear cam gives a pause, a quick rise and fall, then a pause. An eccentric round cam gives a smooth up and down. A snail cam gives a slow rise then a sudden drop. A heart cam gives a steady rise and fall.",
      "asks": [
        "What is a snail cam?",
        "What is an eccentric cam?"
      ]
    },
    {
      "q": "Why does the follower need a spring?",
      "a": "The cam can only push the follower up. A spring or gravity pulls it back down so it stays in contact with the cam. Without it, a fast cam could flick the follower off.",
      "asks": [
        "What keeps the follower on the cam?"
      ]
    },
    {
      "q": "Where are cams used?",
      "a": "Car engines use a camshaft with cams to open and close the valves at exactly the right moments. Cams are also used in automata, sewing machines, music boxes and machine tools.",
      "asks": [
        "What is a camshaft?"
      ]
    }
  ],
  "facts": [
    "In a four-stroke car engine, the camshaft turns once for every two turns of the crankshaft.",
    "A snail cam can only turn one way, or the follower would jam against its step."
  ],
