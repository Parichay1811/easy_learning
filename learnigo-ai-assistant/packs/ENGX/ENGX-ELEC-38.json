  "faq": [
    {
      "q": "What does the live wire do?",
      "a": "The live wire carries the alternating voltage from the supply, about 230 volts in the UK. It is the dangerous one, so the fuse and switches are placed in it.",
      "asks": [
        "Which wire is the brown one?"
      ]
    },
    {
      "q": "What does the neutral wire do?",
      "a": "The neutral wire completes the circuit, carrying the current back to the supply. It stays close to zero volts, near the voltage of the ground.",
      "asks": [
        "Which wire is the blue one?"
      ]
    },
    {
      "q": "When does current flow in the earth wire?",
      "a": "Normally never. It only carries current if a fault makes a metal case live, and then it carries a big current that blows the fuse.",
      "asks": [
        "Does the earth wire carry current?"
      ]
    },
    {
      "q": "Why is the fuse connected to the live wire?",
      "a": "When the fuse blows, it must cut the appliance off from the high voltage. In the live wire, nothing inside stays live once it melts.",
      "asks": [
        "Which wire does the fuse go in?"
      ]
    },
    {
      "q": "Why does a UK plug have a longer earth pin?",
      "a": "The earth pin is longest, so it connects first and disconnects last, and it also opens the shutters that cover the live and neutral holes in the socket.",
      "asks": [
        "Why are UK plug pins different lengths?"
      ]
    }
  ],
  "facts": [
    "UK mains voltage is nominally 230 volts.",
    "UK plug wire colours are brown for live, blue for neutral, and green and yellow for earth."
  ],
