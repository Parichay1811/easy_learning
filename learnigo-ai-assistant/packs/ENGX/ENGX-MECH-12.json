  "faq": [
    {
      "q": "Why does a clock need a pendulum?",
      "a": "A pendulum swings with a very steady beat that depends mainly on its length. The clock counts these swings, so the pendulum sets how fast the hands go.",
      "asks": [
        "What does the pendulum do?",
        "Why do clocks swing?"
      ]
    },
    {
      "q": "What powers a pendulum clock?",
      "a": "A falling weight or a wound-up spring. Winding the clock lifts the weight or tightens the spring, storing energy that is let out slowly over a day or a week.",
      "asks": [
        "Why do you wind a clock?"
      ]
    },
    {
      "q": "What does the escape wheel do?",
      "a": "The escape wheel is the last gear in the train. The anchor lets it move on one tooth at each swing of the pendulum, and its teeth give the pendulum a small push to keep it swinging.",
      "asks": [
        "What is an escapement?",
        "What makes a clock tick?"
      ]
    },
    {
      "q": "How do you make a pendulum clock faster or slower?",
      "a": "Change the pendulum's length. Moving the bob up makes the pendulum shorter and the clock faster; moving it down makes it slower.",
      "asks": [
        "How do you adjust a grandfather clock?"
      ]
    },
    {
      "q": "Who invented the pendulum clock?",
      "a": "Christiaan Huygens built the first pendulum clock in 1656, after Galileo had noticed that a pendulum's swings keep a steady time.",
      "asks": [
        "When was the pendulum clock invented?"
      ]
    }
  ],
  "facts": [
    "Christiaan Huygens built the first pendulum clock in 1656.",
    "A pendulum about 99 centimetres long takes about one second for each swing.",
