  "faq": [
    {
      "q": "What is the rack?",
      "a": "The rack is a straight bar with gear teeth cut along one side. It is like a gear wheel unrolled flat, so it slides instead of spinning.",
      "asks": [
        "What is a toothed bar called?"
      ]
    },
    {
      "q": "What is the pinion?",
      "a": "The pinion is the small round gear that meshes with the rack. As it turns, its teeth push the rack along one tooth at a time.",
      "asks": [
        "What does pinion mean?"
      ]
    },
    {
      "q": "How far does the rack move in one turn?",
      "a": "In one full turn of the pinion, the rack moves a distance equal to the pinion's circumference: the number of teeth on the pinion times the spacing between teeth.",
      "asks": [
        "How do you work out rack movement?"
      ]
    },
    {
      "q": "How does a car steering wheel turn the wheels?",
      "a": "Many cars use rack and pinion steering. The steering column turns a pinion, which slides a rack left or right, and rods on each end of the rack swing the front wheels.",
      "asks": [
        "How does steering work?"
      ]
    },
    {
      "q": "Where else are racks and pinions used?",
      "a": "Racks and pinions are used in mountain railways that climb steep slopes, pillar drills that lower the drill, camera tripods, sliding gates and some lifts.",
      "asks": [
        "What uses a rack and pinion?"
      ]
    }
  ],
  "facts": [
    "Rack railways such as the Pilatus Railway in Switzerland use a rack and pinion to climb gradients of up to 48 percent.",
    "Most modern cars use rack and pinion steering."
  ],
