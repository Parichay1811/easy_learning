  "faq": [
    {
      "q": "What does the boiler do in central heating?",
      "a": "It burns gas, or uses electricity, to heat the water in the loop. The hot water then carries that heat to the radiators.",
      "asks": [
        "How does central heating work?"
      ]
    },
    {
      "q": "Why does central heating need a pump?",
      "a": "Water would barely move round the pipes on its own, so an electric pump pushes it steadily through the boiler and every radiator.",
      "asks": [
        "What moves the water round the radiators?"
      ]
    },
    {
      "q": "What does the room thermostat do?",
      "a": "It measures the air temperature in one room. When the room drops below the setting it turns the heating on, and when the room is warm enough it turns it off.",
      "asks": [
        "How does a thermostat control the heating?"
      ]
    },
    {
      "q": "What does a radiator valve do?",
      "a": "A thermostatic radiator valve has a wax or liquid capsule that expands when the room is warm, closing the valve to let less hot water into that radiator.",
      "asks": [
        "What are the numbers on a radiator valve?"
      ]
    },
    {
      "q": "Why are some radiator pipes hot and some cooler?",
      "a": "One pipe is the flow, carrying hot water in, and the other is the return, carrying water out after it has given away some of its heat.",
      "asks": [
        "Why is one radiator pipe colder?"
      ]
    }
  ],
  "facts": [
    "Wet central heating is a closed loop: the same water circulates between the boiler and radiators.",
    "Thermostatic radiator valves use an expanding wax or liquid capsule to reduce flow when a room is warm."
  ],
