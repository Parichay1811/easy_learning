  "faq": [
    {
      "q": "Why does a winch have a long handle?",
      "a": "The handle is a lever. The further your hand is from the axle compared with the drum's radius, the more your force is multiplied.",
      "asks": [
        "How does the crank handle help?"
      ]
    },
    {
      "q": "Why does a winch have gears?",
      "a": "A small gear driving a big gear slows the drum down and multiplies the turning force. Combined with the handle, a winch can multiply your pull 20 times or more.",
      "asks": [
        "What do the gears in a winch do?"
      ]
    },
    {
      "q": "What does the drum do?",
      "a": "The drum is the cylinder the rope winds onto. A small drum gives more pulling force but winds in less rope per turn.",
      "asks": [
        "Why is the winch drum small?"
      ]
    },
    {
      "q": "What stops the winch unwinding?",
      "a": "A ratchet wheel and a spring-loaded pawl let the drum turn only one way. The pawl catches the teeth if the load pulls back.",
      "asks": [
        "Why does a winch click?"
      ]
    },
    {
      "q": "How do you work out a winch's mechanical advantage?",
      "a": "Multiply the handle radius divided by the drum radius by the gear ratio. A 30 cm handle, a 5 cm drum radius and 4 to 1 gears give 6 times 4, which is 24, before friction.",
      "asks": [
        "How much does a winch multiply force?"
      ]
    }
  ],
  "facts": [
    "A winch combines a wheel and axle with gears, so their mechanical advantages multiply.",
    "Sailing boats use winches to pull in sails against the force of the wind."
  ],
