  "faq": [
    {
      "q": "What powers an escalator?",
      "a": "An electric motor, usually at the top, turns a drive gear that pulls the step chains round in a loop.",
      "asks": [
        "Where is the escalator motor?"
      ]
    },
    {
      "q": "What is the step chain?",
      "a": "Two strong chains, one on each side, carry the steps in a continuous loop. The drive gear pulls them up and they return upside down underneath.",
      "asks": [
        "What carries escalator steps?"
      ]
    },
    {
      "q": "How do escalator steps flatten at the top?",
      "a": "Each step has two sets of wheels on separate tracks. At the ends the tracks are level, so the step lies flat; on the slope the tracks separate, lifting the back of each step into a stair.",
      "asks": [
        "Why do escalator steps disappear?"
      ]
    },
    {
      "q": "Why does the handrail move?",
      "a": "The handrail is a rubber loop driven by the same motor, so it moves at about the same speed as the steps and you can hold on safely. Small speed differences can appear as it wears.",
      "asks": [
        "Why is the handrail sometimes faster than the steps?"
      ]
    },
    {
      "q": "How does an escalator stop safely?",
      "a": "Safety switches watch for things caught at the comb plates or handrail, broken chains and overspeed. Any fault cuts the motor and applies a brake, and there are emergency stop buttons at each end.",
      "asks": [
        "What makes an escalator stop?"
      ]
    }
  ],
