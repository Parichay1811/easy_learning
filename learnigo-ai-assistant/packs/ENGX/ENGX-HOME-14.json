  "faq": [
    {
      "q": "Why does espresso need high pressure?",
      "a": "The coffee is ground very fine and packed tight, so water needs about 9 bar of pressure to push through. The pressure extracts strong flavour and oils quickly, making a small, intense drink.",
      "asks": [
        "How does an espresso machine work?"
      ]
    },
    {
      "q": "What temperature is espresso water?",
      "a": "Usually about 90 to 96 degrees. Water that is too hot makes coffee bitter, and too cool makes it sour and weak.",
      "asks": [
        "Why should espresso water not be boiling?"
      ]
    },
    {
      "q": "What is crema?",
      "a": "Crema is the golden foam on top of an espresso. It forms when pressure forces carbon dioxide and oils out of fresh coffee into tiny bubbles.",
      "asks": [
        "Why does espresso have foam on top?"
      ]
    },
    {
      "q": "How long should an espresso shot take?",
      "a": "About 25 to 30 seconds for a standard shot. Much faster means the grind is too coarse; much slower means it is too fine or packed too hard.",
      "asks": [
        "Why does my espresso run too fast?"
      ]
    },
    {
      "q": "How does the steam wand froth milk?",
      "a": "The boiler also makes steam. Blasting it into milk heats the milk and whips air into it, making tiny bubbles for a creamy foam.",
      "asks": [
        "How do coffee machines make foamy milk?"
      ]
    }
