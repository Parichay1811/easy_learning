  "faq": [
    {
      "q": "How does a washing machine clean clothes?",
      "a": "Detergent loosens grease and dirt, warm water helps dissolve it, and the drum keeps lifting and dropping the clothes so water is pushed through the fabric again and again.",
      "asks": [
        "What does the drum do in a washing machine?"
      ]
    },
    {
      "q": "How does the spin cycle get water out?",
      "a": "The drum spins so fast that the clothes are held against its wall, while the water keeps going in a straight line through the holes. It then drains away.",
      "asks": [
        "Why does the drum have holes?",
        "How does spinning dry clothes?"
      ]
    },
    {
      "q": "Why does a washing machine shake when it spins?",
      "a": "If the clothes bunch up on one side, the spinning drum is unbalanced and wobbles. Heavy concrete weights and springs help steady it, and many machines rebalance the load before spinning.",
      "asks": [
        "Why is there concrete in a washing machine?"
      ]
    },
    {
      "q": "Why does the drum turn both ways?",
      "a": "Turning back and forth stops the clothes tangling into a knot and keeps tumbling them through the water.",
      "asks": [
        "Why does my washing machine keep changing direction?"
      ]
    },
    {
      "q": "Why can you not open the door during a wash?",
      "a": "A door lock stays closed while there is water in the drum or it is spinning, so water cannot flood out and fingers cannot get caught.",
      "asks": [
        "Why is my washing machine door locked?"
      ]
    }
  ],
  "facts": [
    "Many washing machines have concrete blocks attached to the drum to steady it during the spin.",
    "At 1,400 revolutions per minute, the wall of a typical drum pushes clothes with a force several hundred times their weight."
  ],
