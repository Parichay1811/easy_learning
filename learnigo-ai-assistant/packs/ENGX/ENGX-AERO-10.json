  "faq": [
    {
      "q": "How does an autopilot work?",
      "a": "It is a feedback loop: sensors measure the plane's height, heading and speed, a computer compares them with the pilots' targets, and motors move the controls to fix any difference. It repeats this many times a second.",
      "asks": [
        "What does autopilot do?",
        "Does the plane fly itself?"
      ]
    },
    {
      "q": "How does the autopilot know where the plane is?",
      "a": "Gyroscopes and accelerometers sense which way the plane points and turns, probes measure airspeed and height from the air, and GPS and radio beacons give its position.",
      "asks": [
        "What sensors does an autopilot use?"
      ]
    },
    {
      "q": "Who controls the autopilot?",
      "a": "The pilots. They set targets like height, heading, speed or a programmed route, switch modes on and off, and can disconnect it instantly with a button on the control stick.",
      "asks": [
        "Can pilots turn off the autopilot?"
      ]
    },
    {
      "q": "Can autopilot take off?",
      "a": "Airliner autopilots normally don't do the take-off; pilots fly it by hand and switch the autopilot on during the climb. Some systems can land the plane automatically in fog.",
      "asks": [
        "Can autopilot land a plane?"
      ]
    },
    {
      "q": "Why do pilots still need to be there?",
      "a": "Autopilots follow targets but can't judge unexpected situations like storms ahead, emergencies or new instructions from air traffic control. Pilots make the decisions and fly by hand when needed.",
      "asks": [
        "Could a plane fly without pilots?"
      ]
    }
  ],
  "facts": [
    "Lawrence Sperry demonstrated an early gyroscopic autopilot in 1914, flying with his hands off the controls.",
    "Autoland systems let suitably equipped airliners land in fog with almost no visibility."
  ],
