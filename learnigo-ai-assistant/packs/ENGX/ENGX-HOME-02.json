  "faq": [
    {
      "q": "What is a magnetron?",
      "a": "A magnetron is a vacuum tube with magnets around it. Electrons whirling inside it produce microwaves at about 2.45 billion waves per second.",
      "asks": [
        "What makes the microwaves?"
      ]
    },
    {
      "q": "How does a microwave heat food?",
      "a": "Microwaves make water molecules in food flip back and forth very fast. Their jostling turns into heat, which then spreads inwards by conduction.",
      "asks": [
        "Why do microwaves heat water?"
      ]
    },
    {
      "q": "Why does a microwave have a turntable?",
      "a": "The waves bouncing inside make fixed hot and cold spots. Turning the food carries every part through the hot spots so it heats more evenly.",
      "asks": [
        "Why does food heat unevenly in a microwave?"
      ]
    },
    {
      "q": "Why can you see through the door but microwaves cannot get out?",
      "a": "The door has a metal mesh with holes only a few millimetres wide. Light waves are tiny and pass through, but microwaves, about 12 centimetres long, are too big and are reflected.",
      "asks": [
        "Why is there a mesh in the microwave door?"
      ]
    },
    {
      "q": "Why can you not put metal in a microwave?",
      "a": "Metal reflects microwaves, and thin or pointed metal can build up charges that spark. That can damage the oven or start a fire.",
      "asks": [
        "Why does foil spark in the microwave?"
      ]
    }
  ],
  "facts": [
    "Home microwave ovens use microwaves with a frequency of about 2.45 gigahertz, a wavelength of about 12 centimetres.",
    "Percy Spencer noticed microwaves from radar equipment melting a chocolate bar in his pocket and patented the microwave oven in the 1940s."
  ],
