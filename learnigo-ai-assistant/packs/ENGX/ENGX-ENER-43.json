  "faq": [
    {
      "q": "What can heat a Stirling engine?",
      "a": "Any heat source: a gas flame, burning wood, concentrated sunlight, waste heat or radioactive decay. Small toy ones even run on the warmth of a hand or a cup of hot coffee.",
      "asks": [
        "Can a Stirling engine run on sunlight?"
      ]
    },
    {
      "q": "What does the displacer piston do?",
      "a": "It does not push the crank itself. It moves the trapped gas between the hot and cold ends, so the gas is heated and cooled in turn, making its pressure rise and fall.",
      "asks": [
        "Why does a Stirling engine have two pistons?"
      ]
    },
    {
      "q": "How does a Stirling engine make the power piston move?",
      "a": "When most of the gas is at the hot end, it expands and pushes the power piston out. When the displacer moves the gas to the cold end, it contracts and the piston is pulled back in.",
      "asks": [
        "How does heat make a Stirling engine turn?"
      ]
    },
    {
      "q": "Why does a Stirling engine need a flywheel?",
      "a": "The pushes come in pulses, so the heavy flywheel stores energy to carry the engine smoothly through each cycle and to keep the displacer moving at the right moment.",
      "asks": [
        "What does the flywheel do?"
      ]
    },
    {
      "q": "What is a regenerator?",
      "a": "It is a mesh of fine wire or metal between the hot and cold sides. It soaks up heat from gas heading to the cold end and gives it back to gas heading to the hot end, so less fuel is needed.",
      "asks": [
        "How does a Stirling engine save heat?"
      ]
    }
  ],
  "facts": [
    "Robert Stirling, a Scottish minister, patented the Stirling engine in 1816.",
    "Some Swedish submarines use Stirling engines to run quietly underwater without surfacing."
  ],
