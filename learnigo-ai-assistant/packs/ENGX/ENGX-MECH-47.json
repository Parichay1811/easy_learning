  "faq": [
    {
      "q": "What are the clutch jaws?",
      "a": "The clutch is a small split tube whose jaws grip the lead. They move forward with each click, carrying the lead with them.",
      "asks": [
        "What grips the lead in a mechanical pencil?"
      ]
    },
    {
      "q": "What does the clutch ring do?",
      "a": "The ring slides over the jaws and squeezes them shut on the lead. When the clutch moves forward far enough, the ring is held back and the jaws open.",
      "asks": [
        "How do the jaws open and close?"
      ]
    },
    {
      "q": "Why does the lead not slide back in?",
      "a": "A small rubber grip in the tip holds the lead by friction. It is just strong enough to keep the lead still while the clutch slides back for the next click.",
      "asks": [
        "What holds the lead in place?"
      ]
    },
    {
      "q": "What does the spring in a mechanical pencil do?",
      "a": "The spring is squashed when you click and pushes the clutch and button back afterwards, ready for the next click.",
      "asks": [
        "Why does the button spring back?"
      ]
    },
    {
      "q": "Why does the lead break?",
      "a": "Pencil lead is a thin rod of graphite and clay, which is brittle. Too much lead sticking out or pressing hard snaps it.",
      "asks": [
        "How do I stop the lead snapping?"
      ]
    }
  ],
  "facts": [
    "Common mechanical pencil leads are 0.5 or 0.7 millimetres thick.",
    "Pencil lead contains no lead metal; it is graphite mixed with clay or polymer."
  ],
