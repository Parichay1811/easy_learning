  "faq": [
    {
      "q": "How does a pressure washer work?",
      "a": "An electric motor or engine drives pistons in a pump that squeeze ordinary water to very high pressure. A narrow nozzle turns that pressure into a fast, cutting jet.",
      "asks": [
        "What is inside a pressure washer?"
      ]
    },
    {
      "q": "How much pressure does a pressure washer make?",
      "a": "A home pressure washer usually makes about 100 to 150 bar, roughly 40 to 50 times normal mains water pressure.",
      "asks": [
        "How strong is a jet wash?"
      ]
    },
    {
      "q": "Why does the pump not burst when I let go of the trigger?",
      "a": "An unloader valve senses the pressure jump when the trigger closes and sends the water back to the pump inlet, so it circulates harmlessly until you squeeze again.",
      "asks": [
        "What is an unloader valve?"
      ]
    },
    {
      "q": "What does the nozzle do on a pressure washer?",
      "a": "The nozzle is a tiny hole that turns the water pressure into speed. Different nozzles make a narrow cutting jet or a wider, gentler fan of spray.",
      "asks": [
        "Why do pressure washers have different nozzles?"
      ]
    },
    {
      "q": "Why can a pressure washer be dangerous?",
      "a": "The jet is fast enough to cut skin and damage soft wood or paint, so it must never be pointed at people or animals.",
      "asks": [
        "Can a pressure washer hurt you?"
      ]
    }
  ],
  "facts": [
    "Home pressure washers typically work at about 100 to 150 bar, compared with about 1 to 3 bar from a mains tap.",
    "An unloader valve recirculates water when the trigger is released so the pump is not damaged."
  ],
