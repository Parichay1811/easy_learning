  "faq": [
    {
      "q": "Why can't a computer chip power a motor directly?",
      "a": "Chip outputs give only tiny currents, often a few thousandths of an amp, while a motor may need an amp or more. A transistor lets the tiny signal control the big current.",
      "asks": [
        "Why use a transistor with a microcontroller?"
      ]
    },
    {
      "q": "What is the base of a transistor?",
      "a": "In a common bipolar transistor the base is the control leg. A small current into it lets a current around a hundred times bigger flow between the other two legs, the collector and the emitter.",
      "asks": [
        "What are the three legs of a transistor?"
      ]
    },
    {
      "q": "How does a transistor switch without moving?",
      "a": "It is made of layers of silicon with tiny amounts of other elements added. The control current changes how many charges are free to move in the middle layer, opening or closing the path electrically.",
      "asks": [
        "What happens inside a transistor?"
      ]
    },
    {
      "q": "What can a transistor switch on?",
      "a": "Anything from a motor or buzzer to a strip of LEDs or a relay. In robots and gadgets, transistors let small control chips drive the powerful parts.",
      "asks": [
        "What are transistors used for?"
      ]
    },
    {
      "q": "How many transistors are in a computer chip?",
      "a": "Modern processors contain billions of microscopic transistors, each switching on and off billions of times a second. Together they carry out all the computer's logic.",
      "asks": [
        "How small are the transistors in a chip?"
      ]
    }
  ],
  "facts": [
    "The first transistor was built at Bell Labs in 1947.",
    "Modern processor chips contain tens of billions of transistors."
  ],
