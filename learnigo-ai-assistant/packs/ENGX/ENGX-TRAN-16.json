  "faq": [
    {
      "q": "What spins a turbocharger?",
      "a": "Hot exhaust gas from the engine flows through the turbine housing and spins the turbine wheel, using energy that would otherwise go out of the tailpipe.",
      "asks": [
        "How does exhaust power a turbo?"
      ]
    },
    {
      "q": "Why are the turbine and compressor on one shaft?",
      "a": "Joining them means the exhaust-driven turbine directly spins the compressor. No belt or gears are needed, so it can spin extremely fast.",
      "asks": [
        "How fast does a turbo spin?"
      ]
    },
    {
      "q": "What does the compressor do?",
      "a": "The compressor wheel squashes incoming air and pushes it into the engine at higher pressure, so each cylinder gets more oxygen and can burn more fuel.",
      "asks": [
        "How does a turbo make more power?"
      ]
    },
    {
      "q": "What is an intercooler?",
      "a": "An intercooler is a radiator for the intake air. It cools the air after the compressor has squashed it, making it denser so it holds more oxygen.",
      "asks": [
        "Why cool the air in a turbo engine?"
      ]
    },
    {
      "q": "What is turbo lag?",
      "a": "Turbo lag is the short delay before a turbo gives full boost when you press the accelerator. The exhaust flow has to build up and speed up the turbine before the compressor pushes in extra air.",
      "asks": [
        "Why is there a delay with a turbo?"
      ]
    }
  ],
  "facts": [
    "Turbochargers can spin at well over 100,000 revolutions per minute.",
    "Swiss engineer Alfred Büchi patented exhaust-driven turbocharging in 1905.",
    "A supercharger does the same job as a turbo but is driven by a belt from the engine instead of by exhaust gas."
  ],
