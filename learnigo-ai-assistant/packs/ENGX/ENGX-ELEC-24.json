  "faq": [
    {
      "q": "What happens when you press the doorbell button?",
      "a": "Pressing the button closes a switch and completes the circuit. Current flows from the battery or a small transformer to the electromagnet inside the bell.",
      "asks": [
        "What does the bell push do?"
      ]
    },
    {
      "q": "What does the electromagnet in a doorbell do?",
      "a": "When current flows, the coil becomes a magnet and pulls the iron arm towards it, swinging the hammer into the gong.",
      "asks": [
        "Why is there a magnet in a bell?"
      ]
    },
    {
      "q": "Why does a doorbell hammer keep hitting the gong?",
      "a": "As the arm swings in, it pulls away from the contact and breaks the circuit. The magnet switches off, a spring pulls the arm back, the contact closes again, and the cycle repeats many times a second.",
      "asks": [
        "Why does an electric bell ring continuously?"
      ]
    },
    {
      "q": "What is the contact in an electric bell?",
      "a": "It is the point the springy arm touches to complete the circuit. Each swing of the arm opens and closes this contact, which switches the electromagnet on and off by itself.",
      "asks": [
        "What is the contact screw for?"
      ]
    },
    {
      "q": "How do ding-dong doorbells work?",
      "a": "A ding-dong chime uses a coil with a sliding iron plunger. Pressing the button shoots the plunger into one metal bar, ding, and releasing it lets a spring throw it back against the other bar, dong.",
      "asks": [
        "How does a two-tone chime work?"
      ]
    }
  ],
  "facts": [
    "Wired doorbells usually run on low voltage, often 8 to 24 volts from a small transformer.",
    "Electric bells that interrupt their own current date back to the mid-1800s."
  ],
