  "faq": [
    {
      "q": "How does a servo know its position?",
      "a": "A sensor, usually a potentiometer, a variable resistor turned by the output shaft, measures the real angle. The circuit keeps comparing it with the target angle.",
      "asks": [
        "What is inside a servo?"
      ]
    },
    {
      "q": "How do you tell a servo what angle to go to?",
      "a": "You send it a pulse about every 20 milliseconds. A pulse of around 1.5 milliseconds puts it in the middle, and shorter or longer pulses swing it towards each end.",
      "asks": [
        "What is a PWM signal for a servo?"
      ]
    },
    {
      "q": "Why does a servo have gears?",
      "a": "The small motor spins fast but weakly. Gears trade that speed for turning force, called torque, so the arm can move a real load and hold it steady.",
      "asks": [
        "What does the gearbox in a servo do?"
      ]
    },
    {
      "q": "What is the difference between a servo and a normal motor?",
      "a": "A normal motor just spins when powered. A servo has a sensor and control circuit built in, so it moves to and holds a commanded position, which is closed-loop control.",
      "asks": [
        "Servo versus DC motor?"
      ]
    },
    {
      "q": "How far can a hobby servo turn?",
      "a": "Most standard hobby servos turn through about 180 degrees. Continuous-rotation servos spin all the way round, and the signal sets their speed instead.",
      "asks": [
        "Can a servo spin all the way round?"
      ]
    }
  ],
  "facts": [
    "Standard hobby servos expect a pulse every 20 milliseconds, about 50 times a second.",
    "A pulse of about 1.5 milliseconds usually puts a hobby servo at its centre position."
  ],
