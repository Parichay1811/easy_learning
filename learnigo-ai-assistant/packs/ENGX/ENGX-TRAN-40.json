  "faq": [
    {
      "q": "What does the lift fan do?",
      "a": "The lift fan blows air down into the space under the hovercraft. The trapped air builds up pressure that holds the craft up.",
      "asks": [
        "How does a hovercraft lift off?"
      ]
    },
    {
      "q": "How can air hold up a heavy hovercraft?",
      "a": "The air pressure under the craft is only a little higher than normal, but it pushes on a very big area. Pressure times area gives enough force to equal the weight.",
      "asks": [
        "How much pressure is under a hovercraft?"
      ]
    },
    {
      "q": "What is the skirt on a hovercraft for?",
      "a": "The skirt is a flexible rubber curtain around the edge that traps the air cushion and lets the craft ride over waves and rocks without losing its air.",
      "asks": [
        "Why does a hovercraft have a rubber skirt?"
      ]
    },
    {
      "q": "What pushes a hovercraft forward?",
      "a": "Large propellers or fans blow air backwards, pushing the craft forwards. Because it floats on air, very little friction holds it back.",
      "asks": [
        "How does a hovercraft move?"
      ]
    },
    {
      "q": "How is a hovercraft steered?",
      "a": "Rudders in the propeller blast turn the air flow and swing the craft round. With little grip on the ground it tends to drift sideways in turns, so pilots plan ahead.",
      "asks": [
        "Why do hovercraft slide sideways?"
      ]
    }
  ],
  "facts": [
    "The SR.N1, built to Christopher Cockerell's hovercraft design, crossed the English Channel in 1959.",
    "Hovercraft can travel over water, mud, sand, ice and flat land.",
    "Rescue teams use hovercraft on mudflats and thin ice, where boats and vehicles cannot go."
  ],
