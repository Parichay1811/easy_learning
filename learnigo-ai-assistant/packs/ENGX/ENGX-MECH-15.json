  "faq": [
    {
      "q": "How does a key open a lock?",
      "a": "The bumps on the key, called its bitting, lift each pair of pins so the join between them sits exactly at the shear line. With every pin lined up, the plug is free to turn and pull back the bolt.",
      "asks": [
        "What does the key do inside the lock?"
      ]
    },
    {
      "q": "What are driver pins?",
      "a": "Driver pins sit above the key pins, pushed down by springs. When no key is in, they cross the shear line into the plug and stop it turning.",
      "asks": [
        "What are the springs in a lock for?"
      ]
    },
    {
      "q": "What is the plug?",
      "a": "The plug is the cylinder you put the key into. It turns inside the outer case when the pins are lined up, and its cam moves the bolt.",
      "asks": [
        "What turns in a lock?"
      ]
    },
    {
      "q": "What is the shear line?",
      "a": "The shear line is the tiny gap between the plug and the outer case. The plug can only turn when no pin crosses it.",
      "asks": [
        "Why must the pins line up?"
      ]
    },
    {
      "q": "What does the bolt do?",
      "a": "The bolt is the metal bar that slides into the door frame to keep the door shut. Turning the plug moves a cam that draws it back so the door can open.",
      "asks": [
        "How does turning the key move the bolt?"
      ]
    }
  ],
  "facts": [
    "Linus Yale Jr. patented the modern pin tumbler cylinder lock in the 1860s, based on his father's design.",
    "Ancient Egyptians used wooden pin locks about 4,000 years ago."
  ],
