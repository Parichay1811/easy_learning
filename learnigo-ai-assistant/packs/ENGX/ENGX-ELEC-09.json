  "faq": [
    {
      "q": "What happens at the negative end of a battery?",
      "a": "In a common alkaline battery the negative side is zinc powder. The zinc reacts and releases electrons, which flow out through any wire you connect.",
      "asks": [
        "What is the anode in a battery?"
      ]
    },
    {
      "q": "What happens at the positive end of a battery?",
      "a": "The positive side, often manganese dioxide, takes in the electrons arriving from the circuit. That reaction pulls electrons along and keeps the current flowing.",
      "asks": [
        "What is the cathode in a battery?"
      ]
    },
    {
      "q": "What is the electrolyte in a battery?",
      "a": "The electrolyte is a paste or liquid that lets ions, charged atoms, move between the two ends but blocks electrons. That forces the electrons to go the long way round, through your circuit.",
      "asks": [
        "What is the paste inside a battery?"
      ]
    },
    {
      "q": "Why does a battery need two different materials?",
      "a": "One material wants to give up electrons and the other wants to take them. That difference in pull is the battery's voltage, about 1.5 volts for an alkaline cell.",
      "asks": [
        "Where does a battery's voltage come from?"
      ]
    },
    {
      "q": "What is the difference between a cell and a battery?",
      "a": "Strictly, a cell is one unit with two ends, and a battery is several cells joined together, like the six cells inside a 9 volt battery. In everyday speech we call both batteries.",
      "asks": [
        "Is a cell the same as a battery?"
      ]
    }
  ],
  "facts": [
    "Alessandro Volta built the first battery, the voltaic pile, in 1800.",
    "A 9 volt battery contains six 1.5 volt cells joined in series."
  ],
