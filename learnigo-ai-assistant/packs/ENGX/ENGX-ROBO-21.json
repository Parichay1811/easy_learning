  "faq": [
    {
      "q": "How do automatic doors detect people?",
      "a": "Most use a microwave radar sensor that notices movement from the change in reflected waves, or an infrared sensor that detects a person's warmth or reflection. Some use pressure mats.",
      "asks": [
        "What sensor opens automatic doors?"
      ]
    },
    {
      "q": "Why don't automatic doors close on people?",
      "a": "Safety sensors, like infrared beams across the doorway or presence detectors above it, tell the controller someone is there, so the doors stay open. Many motors also reverse if they meet resistance.",
      "asks": [
        "Can automatic doors trap you?"
      ]
    },
    {
      "q": "Why do automatic doors sometimes open when I just walk past?",
      "a": "Motion sensors watch a zone in front of the door, and walking through it can trigger them. Better sensors can tell whether you are heading towards the door or just passing by.",
      "asks": [
        "Why do shop doors open when I walk by?"
      ]
    },
    {
      "q": "What happens to automatic doors in a power cut?",
      "a": "Many have batteries to keep working for a while, and doors on escape routes are designed to be pushed open by hand or to open automatically when power fails.",
      "asks": [
        "Can you open automatic doors without power?"
      ]
    },
    {
      "q": "How does the door move?",
      "a": "An electric motor drives a toothed belt along the top of the doorway. The door panels hang on rollers from a track and are clipped to the belt, so they slide as it moves.",
      "asks": [
        "What moves an automatic sliding door?"
      ]
    }
  ],
