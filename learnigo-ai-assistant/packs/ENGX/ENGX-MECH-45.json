  "faq": [
    {
      "q": "What does the winding key do?",
      "a": "The key turns the centre of the mainspring, coiling it tighter. A ratchet stops it springing straight back while you wind.",
      "asks": [
        "Why do you turn the key?"
      ]
    },
    {
      "q": "What is a mainspring?",
      "a": "A mainspring is a long strip of springy steel coiled into a spiral. Winding it tighter stores energy, and it gives that energy back as it unwinds.",
      "asks": [
        "Where does a wind-up toy keep its energy?"
      ]
    },
    {
      "q": "What do the gears in a wind-up toy do?",
      "a": "The gears turn the slow, strong unwinding of the spring into faster motion at the legs or wheels, trading force for speed.",
      "asks": [
        "Why does a clockwork toy need gears?"
      ]
    },
    {
      "q": "How do the legs move?",
      "a": "A crank on the last gear turns round, and a link from it pushes the legs forward and back, turning spinning into walking.",
      "asks": [
        "How does a toy walk with gears?"
      ]
    },
    {
      "q": "Why does a wind-up toy slow down and stop?",
      "a": "The mainspring pushes hardest when tightly wound. As it unwinds, its force falls, until it can no longer overcome friction and the toy stops.",
      "asks": [
        "Why does the toy run out?"
      ]
    }
  ],
  "facts": [
    "Clockwork toys use the same kind of coiled mainspring as mechanical clocks and watches.",
    "A spring's force is greatest when it is wound tightest."
  ],
