  "faq": [
    {
      "q": "What is a ratchet wheel?",
      "a": "A ratchet wheel is a gear with saw-shaped teeth: one side of each tooth is a gentle slope, the other is steep. The pawl slides over the slopes but catches on the steep faces.",
      "asks": [
        "Why are ratchet teeth sloped?"
      ]
    },
    {
      "q": "What is a pawl?",
      "a": "A pawl is a small hinged catch that rests in the teeth of a ratchet wheel. It lets the wheel turn one way and blocks it the other way.",
      "asks": [
        "What stops the ratchet going back?"
      ]
    },
    {
      "q": "Why does a ratchet click?",
      "a": "Each time a tooth passes, the pawl rides up its slope and then snaps down into the next gap, making a click.",
      "asks": [
        "What is the clicking sound in a ratchet?"
      ]
    },
    {
      "q": "Why does the pawl need a spring?",
      "a": "The spring keeps the pawl pressed into the teeth so it always drops into the next gap. Without it, the pawl could bounce clear and the wheel could slip back.",
      "asks": [
        "What holds the pawl down?"
      ]
    },
    {
      "q": "Where are ratchets used?",
      "a": "Ratchet spanners, winches, cable ties, tape measures, jacks, socket wrenches, bicycle freewheels and seat belt reels all use ratchets.",
      "asks": [
        "What uses a ratchet?"
      ]
    }
  ],
  "facts": [
    "A bicycle freewheel is a ratchet: it lets the wheel spin on while your pedals stay still.",
    "A cable tie is a straight ratchet: its teeth pass the catch one way only."
  ],
