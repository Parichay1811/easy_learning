  "faq": [
    {
      "q": "What is a propeller shaft?",
      "a": "It is the long steel shaft that carries the engine's turning force through a sealed hole in the hull to the propeller at the back.",
      "asks": [
        "How does the engine turn the propeller?"
      ]
    },
    {
      "q": "How does a propeller push a ship?",
      "a": "Its twisted blades push water backwards as they spin. By Newton's third law the water pushes the propeller, and the ship, forwards.",
      "asks": [
        "Why are propeller blades twisted?"
      ]
    },
    {
      "q": "How does a rudder steer a ship?",
      "a": "When the rudder is turned, water flowing past pushes on its side. That sideways push swings the stern across, so the ship turns. It only works while water flows past it.",
      "asks": [
        "Can a stopped ship steer?"
      ]
    },
    {
      "q": "Why is the rudder right behind the propeller?",
      "a": "The propeller sends a fast stream of water straight over the rudder, which makes the rudder much more effective, even at low speed.",
      "asks": [
        "Why is water from the propeller important for steering?"
      ]
    },
    {
      "q": "What is the steering gear?",
      "a": "The steering gear is a set of powerful hydraulic rams or motors near the rudder that turn it on orders from the bridge. A big rudder needs an enormous force to move.",
      "asks": [
        "How is a ship's rudder turned?"
      ]
    }
  ],
  "facts": [
    "A ship's propeller is often called a screw.",
    "The largest ship propellers are around 10 metres across and weigh over 100 tonnes.",
    "Bow thrusters help big ships move sideways when docking."
  ],
