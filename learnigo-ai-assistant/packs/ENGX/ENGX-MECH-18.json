  "faq": [
    {
      "q": "What does the hinge pin do?",
      "a": "The hinge pin runs through the knuckles of both leaves and acts as the pivot. The door turns round it, and it carries the door's weight.",
      "asks": [
        "How does a door hinge work?"
      ]
    },
    {
      "q": "What are hinge leaves?",
      "a": "The leaves are the two flat plates of a hinge. One is screwed to the frame and one to the door, and their curled knuckles interlock around the pin.",
      "asks": [
        "What are the parts of a hinge?"
      ]
    },
    {
      "q": "Why is a door handle far from the hinge?",
      "a": "A push makes a turning effect equal to force times distance from the hinge. Putting the handle far from the hinge gives the biggest turning effect for the smallest push.",
      "asks": [
        "Why are door handles on the edge?",
        "Why is it hard to push a door near the hinge?"
      ]
    },
    {
      "q": "What is a moment?",
      "a": "A moment is the turning effect of a force. It is the force multiplied by its distance from the pivot, measured in newton metres.",
      "asks": [
        "How do you work out a turning effect?"
      ]
    },
    {
      "q": "Why do doors have two or three hinges?",
      "a": "The door's weight pulls it outwards at the top and inwards at the bottom. Hinges spread apart share that load and stop the door sagging.",
      "asks": [
        "Why not use one hinge?"
      ]
    }
