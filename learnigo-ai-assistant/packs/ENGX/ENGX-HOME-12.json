  "faq": [
    {
      "q": "How does an electric toothbrush move?",
      "a": "A motor drives a mechanism that turns spinning into fast back-and-forth motion. Oscillating brushes rotate a round head to and fro, and sonic brushes vibrate the bristles side to side.",
      "asks": [
        "What is a sonic toothbrush?"
      ]
    },
    {
      "q": "How does an electric toothbrush charge without a plug?",
      "a": "It uses induction. A coil in the charger makes a changing magnetic field, which makes a current flow in a matching coil inside the sealed handle.",
      "asks": [
        "Why does a toothbrush have no metal contacts?"
      ]
    },
    {
      "q": "Why does my toothbrush buzz every 30 seconds?",
      "a": "A timer chip pauses the motor briefly every 30 seconds, reminding you to brush each quarter of your mouth for two minutes in total.",
      "asks": [
        "What is the toothbrush timer for?"
      ]
    },
    {
      "q": "Why is the handle sealed?",
      "a": "Water and toothpaste would damage open electrical contacts. Induction charging means the handle can be completely waterproof.",
      "asks": [
        "Can an electric toothbrush get wet?"
      ]
    },
    {
      "q": "Are electric toothbrushes better?",
      "a": "Studies suggest powered toothbrushes remove a little more plaque than manual ones on average, but brushing well for two minutes matters most.",
      "asks": [
        "Do electric toothbrushes clean better?"
      ]
    }
  ],
  "facts": [
    "Most electric toothbrushes charge by induction, so the handle can be sealed against water.",
    "Dentists recommend brushing for two minutes, which is why many electric brushes have a two-minute timer."
  ],
