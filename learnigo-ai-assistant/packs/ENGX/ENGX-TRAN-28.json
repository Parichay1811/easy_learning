  "faq": [
    {
      "q": "Who changes the railway points?",
      "a": "Points are set by signallers in signal boxes or, today, mostly by computers in large control centres. Old points were worked by hand with long levers and rods.",
      "asks": [
        "How are points controlled?"
      ]
    },
    {
      "q": "What is a point motor?",
      "a": "A point motor is an electric or hydraulic machine beside the track that moves the switch rails when commanded, then holds them in position.",
      "asks": [
        "What moves railway points?"
      ]
    },
    {
      "q": "What does the drive rod do?",
      "a": "The drive rod links the point motor to the switch rails and moves both together, so one closes against its rail as the other opens.",
      "asks": [
        "How are both switch rails moved?"
      ]
    },
    {
      "q": "How do points steer a train?",
      "a": "Trains have no steering, so the track does it. The moved switch rail guides the inside flanges of the wheels, leading the wheelset onto one route or the other.",
      "asks": [
        "What are switch rails?"
      ]
    },
    {
      "q": "How do signals know the points are set?",
      "a": "Detectors check that the switch rails are fully home and locked. The signalling will not show a proceed signal over points that are not proved in the right position.",
      "asks": [
        "Why must points be locked?"
      ]
    }
  ],
  "facts": [
    "In North America railway points are called switches or turnouts.",
    "Many points have electric heaters to stop snow and ice jamming them.",
    "Signals are interlocked with points, so a signal cannot clear for a route whose points are wrongly set."
  ],
