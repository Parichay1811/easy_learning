  "faq": [
    {
      "q": "What is a cable landing station?",
      "a": "A landing station is the building where an undersea cable comes ashore. It powers the cable's repeaters and connects its fibres to the land networks and data centres.",
      "asks": [
        "Where do undersea cables come ashore?"
      ]
    },
    {
      "q": "What does a repeater do on an undersea cable?",
      "a": "A repeater is a sealed unit on the seabed that boosts the fading light signal, using a short length of special fibre powered by electricity sent along the cable from the shore. Repeaters sit every 50 to 100 kilometres.",
      "asks": [
        "Why does an undersea cable need power?"
      ]
    },
    {
      "q": "How thick is an undersea internet cable?",
      "a": "In the deep sea, about 2 to 3 centimetres across, like a garden hose: fibres in a protective tube, steel strength wires, a copper layer and plastic insulation. Near shore, extra steel armour makes it much thicker.",
      "asks": [
        "What is inside an undersea cable?"
      ]
    },
    {
      "q": "How are broken undersea cables fixed?",
      "a": "Special cable ships find the break, lower a grapnel hook to lift the cable, splice a new section onto both ends on deck, test it and lay it back down. Repairs can take days to weeks.",
      "asks": [
        "What happens if an undersea cable breaks?"
      ]
    },
    {
      "q": "Why use cables instead of satellites?",
      "a": "Cables carry vastly more data, and light in fibre takes a short, direct path, so there is less delay than bouncing signals off a satellite 36,000 kilometres up.",
      "asks": [
        "Is the internet carried by satellites or cables?"
      ]
    }
  ],
  "facts": [
    "Well over 95 percent of intercontinental internet data travels through undersea cables.",
    "The first transatlantic telegraph cable was completed in 1858 but failed after a few weeks."
  ],
