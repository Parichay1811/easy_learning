  "faq": [
    {
      "q": "What is irony in the opening line of Pride and Prejudice?",
      "a": "The line claims a rich single man must want a wife, but the novel shows it is families with daughters who want rich men. The grand statement means the opposite of what it seems to say.",
      "asks": [
        "It is a truth universally acknowledged meaning"
      ]
    },
    {
      "q": "What is free indirect discourse?",
      "a": "Narration that slips into a character's thoughts and words without quotation marks, blending the narrator's voice with the character's. Austen uses it to show Elizabeth's mind, errors included.",
      "asks": [
        "Free indirect speech in Austen"
      ]
    },
    {
      "q": "Why does Elizabeth refuse Darcy’s first proposal?",
      "a": "He proposes proudly, dwelling on her inferior family, and she believes he ruined her sister Jane's chances and wronged Wickham. Her pride and her prejudice both speak.",
      "asks": [
        "Hunsford proposal"
      ]
    },
    {
      "q": "Why does Charlotte Lucas marry Mr Collins?",
      "a": "She is twenty-seven, plain and without money, and marriage offers her a home and security. She tells Elizabeth she is not romantic and asks only a comfortable home.",
      "asks": [
        "Charlotte and Mr Collins"
      ]
    },
    {
      "q": "What does Darcy do for Lydia?",
      "a": "He tracks down Wickham and Lydia in London and pays Wickham's debts and a settlement so he will marry her, saving the Bennet family's reputation, and asks that no one be told.",
      "asks": [
        "How does Darcy help the Bennets?"
      ]
    }
  ],
