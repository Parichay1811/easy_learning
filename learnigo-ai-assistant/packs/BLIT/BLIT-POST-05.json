  "faq": [
    {
      "q": "Why did Walcott rewrite Homer in the Caribbean?",
      "a": "To claim that the lives of poor Caribbean fishermen are as worthy of epic as Greek heroes, and to answer European tradition from the islands, while also questioning whether the Homeric frame fits at all.",
      "asks": [
        "Omeros and the Odyssey"
      ]
    },
    {
      "q": "What is Philoctete's wound?",
      "a": "A sore on his shin from a rusty anchor that will not heal. It echoes Homer's wounded Philoctetes and stands for the inherited pain of slavery, healed at last by Ma Kilman with an African herb.",
      "asks": [
        "Philoctete Omeros"
      ]
    },
    {
      "q": "What happens in Achille's journey to Africa?",
      "a": "In a sunstroke vision Achille is guided across the Atlantic to West Africa, where he meets his ancestor Afolabe and witnesses the capture of people into slavery, before returning home.",
      "asks": [
        "Achille Afolabe"
      ]
    },
    {
      "q": "Who is Helen in Omeros?",
      "a": "A beautiful local woman whom Achille and Hector both love. She also stands for Saint Lucia itself, nicknamed the Helen of the West Indies because Britain and France fought over it so often.",
      "asks": [
        "Helen Saint Lucia Omeros"
      ]
    },
    {
      "q": "What form is Omeros written in?",
      "a": "Seven books and sixty-four chapters of three-line stanzas, loosely rhymed in a pattern that echoes Dante's terza rima, with long, flexible lines.",
      "asks": [
        "Omeros terza rima"
      ]
    }
