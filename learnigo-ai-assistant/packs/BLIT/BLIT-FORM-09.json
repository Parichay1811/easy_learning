  "faq": [
    {
      "q": "What is intertextuality?",
      "a": "The idea that every text is shaped by, and gets meaning from, other texts: quotations, allusions, genres, conventions and shared language. Readers make meaning by recognising these connections.",
      "asks": [
        "Intertextuality definition"
      ]
    },
    {
      "q": "What is the difference between allusion and intertextuality?",
      "a": "An allusion is a deliberate, specific reference by an author. Intertextuality is the broader web of relations between texts, including unintended echoes and the reader's own associations.",
      "asks": [
        "Allusion vs intertextuality"
      ]
    },
    {
      "q": "Who coined intertextuality?",
      "a": "The Bulgarian-French critic Julia Kristeva in the late 1960s, developing Mikhail Bakhtin's idea that texts are dialogues of many voices.",
      "asks": [
        "Julia Kristeva intertextuality"
      ]
    },
    {
      "q": "What is the difference between parody and pastiche?",
      "a": "Both imitate another work or style. Parody exaggerates in order to mock or criticise; pastiche imitates with affection or playfulness, without mockery.",
      "asks": [
        "Parody vs pastiche"
      ]
    },
    {
      "q": "Is intertextuality the same as plagiarism?",
      "a": "No. Intertextual borrowing is open and transforms its source, expecting readers to notice. Plagiarism hides the borrowing and passes off someone else's work as one's own.",
      "asks": [
        "Is retelling a story plagiarism?"
      ]
    }
  ],
