  "faq": [
    {
      "q": "How does GPS find your position?",
      "a": "Each satellite broadcasts its position and the exact time. The receiver measures how long each signal took, turns that into distances, and finds the one point that fits them all.",
      "asks": [
        "How does GNSS work?",
        "Satellite ranging"
      ]
    },
    {
      "q": "Why do you need four satellites?",
      "a": "Three distances would fix a position if the receiver clock were perfect. A fourth lets the receiver solve for its own clock error as well as the three coordinates.",
      "asks": [
        "Why four satellites for GPS?"
      ]
    },
    {
      "q": "What is RTK GPS?",
      "a": "Real-time kinematic positioning: a base station on a known point sends corrections to a rover, which also uses carrier phase measurements, giving positions to about 1 to 2 centimetres in real time.",
      "asks": [
        "How does RTK work?",
        "Base and rover GPS"
      ]
    },
    {
      "q": "How accurate is GNSS surveying?",
      "a": "A phone or handheld gets a few metres. RTK reaches 1 to 2 centimetres, and long static sessions with post-processing can reach millimetres.",
      "asks": [
        "GPS accuracy"
      ]
    },
    {
      "q": "What is the difference between GPS and GNSS?",
      "a": "GPS is the American system. GNSS, global navigation satellite systems, covers all of them: GPS, GLONASS, Galileo and BeiDou, plus regional systems such as NavIC and QZSS.",
      "asks": [
        "GPS vs GNSS"
      ]
    }
  ],
  "facts": [
    "GPS satellites orbit at an altitude of about 20,200 km.",
    "The GPS L1 carrier at 1575.42 MHz has a wavelength of about 19 cm."
  ],
