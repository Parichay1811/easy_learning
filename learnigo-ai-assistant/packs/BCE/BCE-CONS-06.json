  "faq": [
    {
      "q": "What is a Gantt chart?",
      "a": "A bar chart of a project schedule: each activity is a horizontal bar from its start date to its finish date against a time scale, often with links between dependent tasks and milestones.",
      "asks": [
        "What is a Gantt chart in construction?"
      ]
    },
    {
      "q": "What is an S-curve in construction?",
      "a": "A graph of cumulative cost or progress against time. It is S-shaped because work starts slowly, speeds up in the middle and tapers off at the end.",
      "asks": [
        "How do you read an S-curve?"
      ]
    },
    {
      "q": "What is earned value?",
      "a": "The budgeted cost of the work actually completed so far. Comparing it with planned value and actual cost shows whether a project is on schedule and on budget.",
      "asks": [
        "Earned value management",
        "EVM"
      ]
    },
    {
      "q": "What do SPI and CPI mean?",
      "a": "The schedule performance index is earned value over planned value; the cost performance index is earned value over actual cost. Values below 1 mean behind schedule or over budget.",
      "asks": [
        "How do you calculate SPI and CPI?"
      ]
    },
    {
      "q": "How do you forecast the final cost of a project?",
      "a": "A common estimate at completion is the budget at completion divided by the CPI. With a 10 million budget and CPI of 0.84, the forecast is about 11.9 million.",
      "asks": [
        "Estimate at completion",
        "EAC formula"
      ]
    }
  ],
  "facts": [
    "Henry Gantt developed his bar chart in the 1910s; Karol Adamiecki in Poland drew a similar harmonogram in 1896.",
    "In earned value management, SPI = EV/PV and CPI = EV/AC."
  ],
