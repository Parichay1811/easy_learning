  "faq": [
    {
      "q": "What is a contour line?",
      "a": "A line on a map joining points of equal height above a datum. Together, contours show the shape of the land in three dimensions on a flat map.",
      "asks": [
        "Define contour",
        "What are contour lines?"
      ]
    },
    {
      "q": "What is the contour interval?",
      "a": "The constant vertical distance between neighbouring contours, such as 1, 2, 5 or 10 metres. It is chosen to suit the map scale and how steep the land is.",
      "asks": [
        "Vertical interval"
      ]
    },
    {
      "q": "How do you find the gradient from contours?",
      "a": "Divide the vertical interval by the horizontal distance between two contours. Five metres over 25 metres is 1 in 5, a 20 percent slope.",
      "asks": [
        "Gradient from a contour map",
        "Horizontal equivalent"
      ]
    },
    {
      "q": "How do you interpolate contours?",
      "a": "Assume the ground slopes evenly between two spot heights and place the contour in proportion to the height difference. The 110 metre contour lies halfway between 102.4 and 117.6.",
      "asks": [
        "Contour interpolation"
      ]
    },
    {
      "q": "How do you recognise a valley or ridge on a contour map?",
      "a": "Contours form Vs: in a valley the V points uphill, towards higher contours, and in a ridge it points downhill. Closed rings mark a hill or a hollow.",
      "asks": [
        "Valley vs ridge contours"
      ]
    }
  ],
  "facts": [
    "Charles Hutton used contour lines in 1778 to analyse the 1774 Schiehallion experiment that estimated the Earth's density.",
    "Contour lines never cross or split, except at an overhanging cliff or cave."
  ],
