  "faq": [
    {
      "q": "What is activated sludge?",
      "a": "A secondary treatment process in which sewage is mixed with a thick, aerated suspension of microbes that eat the organic matter; the microbes settle in a clarifier and most are returned to the tank.",
      "asks": [
        "How does the activated sludge process work?"
      ]
    },
    {
      "q": "What is the food to microorganism ratio?",
      "a": "F/M is the BOD load per day divided by the mass of microbes in the tank: Q times S0 over V times X. Here 20,000 times 200 over 5,000 times 2,500 gives 0.32 per day.",
      "asks": [
        "How do you calculate F/M?",
        "F/M ratio"
      ]
    },
    {
      "q": "What is hydraulic retention time?",
      "a": "The average time water spends in a tank: volume divided by flow. A 5,000 cubic metre tank fed 20,000 cubic metres a day has an HRT of 6 hours.",
      "asks": [
        "HRT formula"
      ]
    },
    {
      "q": "Why is sludge returned to the aeration tank?",
      "a": "Returning settled sludge keeps a high concentration of hungry microbes in the tank, so the treatment is fast. Without it the microbes would wash out with the water.",
      "asks": [
        "What is return activated sludge?"
      ]
    },
    {
      "q": "What is sludge age?",
      "a": "Sludge age, or solids retention time, is the average time microbes stay in the system: the mass of sludge in the tank divided by the mass wasted per day. About 5 to 15 days is common.",
      "asks": [
        "Solids retention time",
        "SRT"
      ]
    }
  ],
  "facts": [
    "Edward Ardern and William Lockett announced the activated sludge process in Manchester in 1914.",
    "Aeration is usually the largest energy user in an activated sludge plant, often around half of its electricity."
  ],
