  "faq": [
    {
      "q": "What is sustainable drainage?",
      "a": "Sustainable drainage systems, SuDS, manage rain close to where it falls using green roofs, rain gardens, swales, permeable paving and ponds, to slow runoff, clean it and make space for nature.",
      "asks": [
        "What is SuDS?",
        "What are sustainable drainage systems?"
      ]
    },
    {
      "q": "How does permeable paving work?",
      "a": "Rain passes through gaps in the paving into a sub-base of open-graded stone with about 30 percent voids, which stores it and lets it soak away or drain out slowly.",
      "asks": [
        "How does permeable paving store rainwater?"
      ]
    },
    {
      "q": "What is a detention pond?",
      "a": "A pond or basin that fills during storms and empties slowly through a small outlet, cutting the peak flow sent to the stream. A retention pond keeps a permanent pool of water as well.",
      "asks": [
        "Detention vs retention pond"
      ]
    },
    {
      "q": "What is a SuDS management train?",
      "a": "A chain of SuDS features in series: source control where rain lands, then site control, then regional control such as a pond, so each step slows and cleans the water further.",
      "asks": [
        "SuDS train"
      ]
    },
    {
      "q": "What is a sponge city?",
      "a": "China's programme, launched in 2015, to make cities absorb, store and reuse rain with parks, wetlands, porous paving and green roofs instead of relying only on pipes.",
      "asks": [
        "Sponge city China"
      ]
    }
  ],
  "facts": [
    "China's sponge city programme started in 2015 with pilot cities including Wuhan.",
    "The CIRIA SuDS Manual sets four aims for SuDS: water quantity, water quality, amenity and biodiversity."
  ],
