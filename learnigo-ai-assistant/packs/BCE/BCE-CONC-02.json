  "faq": [
    {
      "q": "What is curing of concrete?",
      "a": "Curing means keeping new concrete moist and at a suitable temperature so the cement can keep reacting with water. It is done by ponding, wet coverings, plastic sheets or curing compounds.",
      "asks": [
        "Why do we water new concrete?",
        "Define curing"
      ]
    },
    {
      "q": "How strong is concrete after 7 days?",
      "a": "Ordinary Portland cement concrete typically reaches about 65 to 70 percent of its 28-day strength after 7 days of moist curing.",
      "asks": [
        "7 day strength of concrete"
      ]
    },
    {
      "q": "Why is concrete tested at 28 days?",
      "a": "By 28 days most of the strength gain has happened, so it became the standard age for checking that a mix meets its grade. Concrete still gains a little strength after that.",
      "asks": [
        "Why 28 days for concrete?"
      ]
    },
    {
      "q": "What happens if concrete is not cured?",
      "a": "Water evaporates, hydration stops early, and the concrete ends up weaker, more porous and prone to surface cracking and dusting. Its durability suffers as well as its strength.",
      "asks": [
        "Effects of poor curing"
      ]
    },
    {
      "q": "How long should concrete be cured?",
      "a": "India's IS 456 asks for at least 7 days for ordinary Portland cement and at least 10 days where mineral admixtures or blended cements are used, and longer in hot, dry weather.",
      "asks": [
        "Minimum curing period"
      ]
    }
  ],
  "facts": [
    "IS 456 asks for at least 7 days of moist curing for ordinary Portland cement concrete, and at least 10 days with mineral admixtures or blended cements.",
    "Cement hydration gives off heat, so massive pours such as dam blocks are often cooled with embedded pipes."
  ],
