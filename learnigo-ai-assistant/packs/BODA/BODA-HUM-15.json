  "faq": [
    {
      "q": "What does the liver do?",
      "a": "The liver has hundreds of jobs. It processes nutrients from the gut, stores sugar as glycogen, makes proteins for the blood, breaks down harmful substances and old red blood cells, and makes bile to help digest fat.",
      "asks": [
        "Tell me about the liver",
        "What are the liver's jobs?"
      ]
    },
    {
      "q": "What is the hepatic portal vein?",
      "a": "It is the vein that carries blood from the stomach and intestines straight to the liver, so the liver can process absorbed nutrients and filter out harmful substances before the blood reaches the rest of the body.",
      "asks": [
        "Tell me about the portal vein",
        "Why does gut blood go to the liver first?"
      ]
    },
    {
      "q": "How does the liver store sugar?",
      "a": "After a meal the liver links glucose molecules into long chains called glycogen. Between meals it breaks glycogen back into glucose and releases it into the blood.",
      "asks": [
        "What is glycogen?"
      ]
    },
    {
      "q": "What does the gallbladder do?",
      "a": "The gallbladder is a small pouch under the liver that stores and concentrates bile. After a fatty meal it squeezes bile into the small intestine.",
      "asks": [
        "Tell me about the gallbladder",
        "What is bile for?"
      ]
    },
    {
      "q": "Can the liver grow back?",
      "a": "The liver is unusually good at regrowing. If part of it is removed, the remaining liver cells divide and it can grow back to near its original size within weeks to months.",
      "asks": [
        "Does the liver regenerate?"
      ]
    }
  ],
  "facts": [
    "The liver is the largest internal organ, weighing about 1.5 kilograms in an adult.",
    "About three quarters of the blood reaching the liver arrives through the hepatic portal vein.",
    "Bile is made in the liver and stored in the gallbladder."
  ],
