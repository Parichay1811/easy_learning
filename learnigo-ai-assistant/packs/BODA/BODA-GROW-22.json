  "faq": [
    {
      "q": "What are stem cells?",
      "a": "Stem cells are unspecialised cells that can divide to make more of themselves and can also turn into specialised cells, such as blood, skin or muscle cells.",
      "asks": [
        "What is a stem cell?",
        "Why are stem cells special?"
      ]
    },
    {
      "q": "What is self-renewal?",
      "a": "Self-renewal means a stem cell divides to make at least one new stem cell, so the store never runs out. The other daughter cell can go on to specialise.",
      "asks": [
        "How do stem cells not run out?",
        "Do stem cells copy themselves?"
      ]
    },
    {
      "q": "Where are stem cells found in adults?",
      "a": "Adults have stem cells in many tissues, including bone marrow, the skin, the gut lining, muscles, hair follicles and the brain. Each kind usually makes only the cells of its own tissue.",
      "asks": [
        "Do adults have stem cells?",
        "Where are blood stem cells?"
      ]
    },
    {
      "q": "What is the difference between embryonic and adult stem cells?",
      "a": "Embryonic stem cells, from a very early embryo, can become almost any type of cell. Adult stem cells are more limited and usually make only the cell types of the tissue they live in.",
      "asks": [
        "What are embryonic stem cells?",
        "Can adult stem cells become anything?"
      ]
    },
    {
      "q": "Why can't every part of the body repair itself?",
      "a": "Some tissues, such as heart muscle and most of the brain, have very few active stem cells. Damage there is often patched with scar tissue instead of being fully replaced.",
      "asks": [
        "Why doesn't heart muscle regrow?",
        "Which parts of the body cannot heal?"
      ]
    }
  ],
  "facts": [
    "Blood stem cells in the bone marrow can make every type of blood cell.",
    "The inner lining of the gut is renewed by stem cells every few days."
  ],
