  "faq": [
    {
      "q": "What is tissue fluid?",
      "a": "Tissue fluid is the liquid that leaks out of blood capillaries and bathes your cells, bringing them food and oxygen. Most of it goes back into the blood, and the rest drains into lymph vessels.",
      "asks": [
        "Tell me about the tissue fluid",
        "What is lymph?"
      ]
    },
    {
      "q": "What do lymph nodes do?",
      "a": "Lymph nodes are small filters along the lymph vessels. They are full of white blood cells that catch germs and debris in the lymph and start immune responses.",
      "asks": [
        "Tell me about the lymph node",
        "Why do glands in your neck swell?"
      ]
    },
    {
      "q": "Where does lymph go?",
      "a": "Lymph flows through larger and larger vessels and finally drains into big veins under the collarbones, near the heart, so the fluid rejoins the blood.",
      "asks": [
        "Tell me about the vein by the heart"
      ]
    },
    {
      "q": "How does lymph move without a pump?",
      "a": "Lymph vessels have one-way valves. Squeezing from nearby muscles, breathing movements and the vessel walls themselves push lymph along, and the valves stop it flowing back.",
      "asks": [
        "Does the lymph system have a heart?"
      ]
    },
    {
      "q": "How much lymph does the body make?",
      "a": "Roughly 2 to 4 litres of fluid a day return to the blood through the lymph system.",
      "asks": [
        "How much fluid does the lymph system carry?"
      ]
    }
  ],
  "facts": [
    "The human body has several hundred lymph nodes.",
    "The thoracic duct, the largest lymph vessel, drains into the veins at the base of the neck on the left side."
  ],
