  "faq": [
    {
      "q": "What does the stomach do to food?",
      "a": "The stomach stores food, mixes it with acid and enzymes, and churns it with muscle waves until it becomes a thick liquid called chyme. Then it releases the chyme slowly into the small intestine.",
      "asks": [
        "Tell me about the stomach",
        "What is the stomach for?"
      ]
    },
    {
      "q": "What is the pyloric valve?",
      "a": "The pyloric sphincter is a ring of muscle at the exit of the stomach. It stays mostly closed and opens a little at a time, letting small squirts of chyme into the small intestine.",
      "asks": [
        "Tell me about the pyloric valve",
        "How does food leave the stomach?"
      ]
    },
    {
      "q": "What is in gastric juice?",
      "a": "Gastric juice contains hydrochloric acid, the enzyme pepsin that breaks down proteins, mucus that protects the lining, and water.",
      "asks": [
        "Tell me about the acid glands"
      ]
    },
    {
      "q": "What is chyme?",
      "a": "Chyme is the thick, soupy mix of partly digested food, acid and enzymes that the stomach makes before passing it on to the small intestine.",
      "asks": [
        "What does food look like after the stomach?"
      ]
    },
    {
      "q": "How long does food stay in the stomach?",
      "a": "Usually a few hours, often about two to four. Fatty meals stay longer than watery or sugary ones.",
      "asks": [
        "How long does the stomach take to empty?"
      ]
    }
  ],
  "facts": [
    "The stomach wall has three layers of muscle running in different directions.",
    "Stomach mixing waves happen about three times per minute.",
    "An adult stomach can stretch to hold about 1 to 1.5 litres after a meal."
  ],
