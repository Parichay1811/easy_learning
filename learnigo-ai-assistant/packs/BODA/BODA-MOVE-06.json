  "faq": [
    {
      "q": "How do tendons store energy?",
      "a": "A tendon is a tough, slightly stretchy cord joining muscle to bone. When it is stretched, like a rubber band, it stores elastic energy, and when it recoils it gives most of that energy back.",
      "asks": [
        "What is elastic energy in tendons?",
        "How does a tendon act like a spring?"
      ]
    },
    {
      "q": "Why do kangaroos hop instead of run?",
      "a": "Hopping on springy tendons is very efficient at speed. When a kangaroo goes faster it takes longer hops at almost the same rate, so its energy use barely rises, letting it travel far to find food and water.",
      "asks": [
        "Why don't kangaroos walk?",
        "Is hopping efficient?"
      ]
    },
    {
      "q": "How far can a kangaroo jump?",
      "a": "A big red kangaroo can cover around 8 metres in a single bound and clear fences about 3 metres high, though its ordinary hops are much shorter.",
      "asks": [
        "How high can a kangaroo jump?",
        "How long is a kangaroo's hop?"
      ]
    },
    {
      "q": "How fast can a kangaroo hop?",
      "a": "Red kangaroos often cruise at about 20 to 25 kilometres per hour and can sprint at 50 or more for short distances.",
      "asks": [
        "What is a kangaroo's top speed?",
        "How fast do kangaroos go?"
      ]
    },
    {
      "q": "What is a kangaroo's tail for?",
      "a": "When moving slowly, a kangaroo pushes down on its strong tail like a fifth leg while it swings its back legs forward. When hopping fast, the tail balances the body.",
      "asks": [
        "Why do kangaroos have big tails?",
        "Do kangaroos use their tail to walk?"
      ]
