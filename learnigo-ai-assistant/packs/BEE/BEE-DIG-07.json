    {
      "say": "The secret is feedback. Join two NOR gates so each one's output feeds the other's input, and you get an SR latch, for set and reset. Follow the chain: pulse S to 1 and Q goes high; let S fall back to 0 and Q stays high, because the loop holds it. That held state is memory. What do you think R does?",
      "draw": [
        {
          "op": "sim",
          "name": "x-chain",
          "stages": [
            {
              "label": "S = 1 → Q = 1",
              "icon": "switch",
              "note": "Set: the output goes high",
              "ask": "How does an SR latch remember?"
            },
            {
              "label": "S back to 0",
              "icon": "key",
              "note": "Q stays 1: the loop holds it"
            },
            {
              "label": "R = 1 → Q = 0",
              "icon": "switch",
              "note": "Reset: the output goes low"
            },
            {
              "label": "R back to 0",
              "icon": "key",
              "note": "Q stays 0: remembered again"
            },
            {
              "label": "S = R = 1",
              "icon": "lightning",
              "note": "Forbidden: both outputs forced to 0",
              "ask": "Why is S = R = 1 not allowed in an SR latch?"
            }
          ],
          "focus": 1
        },
        {
          "op": "formula",
          "text": "NOR latch: Q = (R + Q̄)',  Q̄ = (S + Q)'"
        }
      ]
    },
