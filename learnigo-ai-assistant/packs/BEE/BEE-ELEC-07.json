  "faq": [
    {
      "q": "How does a MOSFET work?",
      "a": "Voltage on the insulated gate attracts carriers to form a conducting channel between source and drain. Above the threshold voltage, more gate voltage means a wider channel and more current.",
      "asks": [
        "What is a MOSFET?",
        "How does a MOSFET switch on?"
      ]
    },
    {
      "q": "Why does a MOSFET gate draw no current?",
      "a": "The gate is separated from the channel by a thin insulating layer of silicon dioxide, so it acts like a tiny capacitor. Current flows only briefly to charge it.",
      "asks": [
        "Is a MOSFET voltage controlled?"
      ]
    },
    {
      "q": "What is the threshold voltage?",
      "a": "The gate-to-source voltage at which the channel starts to form and drain current begins to flow, about 2 volts in this example.",
      "asks": [
        "What is Vth of a MOSFET?"
      ]
    },
    {
      "q": "What is R_DS(on)?",
      "a": "The drain-to-source resistance when the MOSFET is fully switched on. Power MOSFETs reach a few milliohms, so as switches they waste very little heat.",
      "asks": [
        "Why do MOSFETs run cool as switches?"
      ]
    },
    {
      "q": "What is transconductance?",
      "a": "Transconductance, g m, is how much the drain current changes per volt of gate voltage, the slope of the transfer curve. The voltage gain is roughly g m times the drain resistance.",
      "asks": [
        "How does a MOSFET amplify?"
      ]
    }
  ],
  "facts": [
    "Mohamed Atalla and Dawon Kahng demonstrated the first MOSFET at Bell Labs in 1959.",
