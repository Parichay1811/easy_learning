        {
          "op": "clear"
        },
        {
          "op": "title",
          "text": "Column vectors"
        },
        {
          "op": "vecgrid",
          "range": 5
        },
        {
          "op": "vec",
          "from": [
            0,
            0
          ],
          "v": [
            4,
            1
          ],
          "color": "blue",
          "label": "a",
          "at": "move"
        },
        {
          "op": "colvec",
          "name": "a",
          "v": [
            4,
            1
          ],
          "color": "blue",
          "at": "top"
        }
      ]
    },
    {
      "say": "The bottom number says how far up or down: up is positive, and down is negative.",
      "draw": [
        {
          "op": "vec",
          "from": [
            0,
            0
          ],
          "v": [
            -1,
            3
          ],
          "color": "orange",
          "label": "b",
          "at": "bottom"
        },
        {
          "op": "colvec",
          "name": "b",
          "v": [
            -1,
            3
          ],
          "color": "orange",
          "at": "up"
        }
      ]
    },
    {
      "say": "To add two vectors, add the tops, then add the bottoms. So a plus b is 3 over 4: one move after the other.",
      "draw": [
        {
          "op": "vec",
          "from": [
            4,
            1
          ],
