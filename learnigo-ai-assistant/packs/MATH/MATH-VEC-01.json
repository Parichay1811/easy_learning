        {
          "show": "(3, 4)",
          "say": "3 over 4",
          "col": [
            3,
            4
          ]
        },
        {
          "show": "(-3, 4)",
          "say": "minus 3 over 4",
          "col": [
            -3,
            4
          ]
        },
        {
          "show": "(4, -3)",
          "say": "4 over minus 3",
          "col": [
            4,
            -3
          ]
        },
        {
          "show": "(-4, 3)",
          "say": "minus 4 over 3",
          "col": [
            -4,
            3
          ]
        }
      ],
      "answer": 1,
      "why": "Left is negative and up is positive: minus 3 over 4.",
      "wrong": {
        "0": "That is 3 right. Left is negative.",
        "2": "The rows are swapped, and a sign slipped.",
        "3": "The rows are swapped. The top number is across."
