  "faq": [
    [
      "What is a column vector?",
      "A column vector is a move written as two numbers, one above the other: across on top, up or down below."
    ],
    {
      "q": "Is the top number always across?",
      "a": "Yes. The top number is across, right positive. The bottom is up or down, up positive.",
      "asks": [
        "which number goes sideways",
        "which number in a column vector is across",
        "what does the top number mean"
      ]
    },
    [
      "Why is there an arrow over AB?",
      "The arrow shows direction: AB goes from A to B. BA is the reverse, with every sign flipped."
    ],
    [
      "Do I need brackets for a column vector?",
      "Yes. Write the two numbers in tall brackets, one above the other, with no comma."
    ],
    {
      "q": "What is a scalar?",
      "a": "A scalar is just a number that multiplies a vector, like the 2 in 2a. It stretches the arrow.",
      "asks": [
        "what does scalar mean",
        "what is the 2 in 2a"
      ]
    },
    {
      "q": "Is a minus b the same as b minus a?",
      "a": "No. Each one is minus the other, so every sign flips.",
      "asks": [
        "is a take away b the same as b take away a",
        "does the order matter when subtracting vectors"
      ]
    },
    [
      "What is the difference between a and minus a?",
      "Same length, opposite direction. Both signs flip."
    ]
  ],
  "quiz": [
    {
      "say": "Which column vector means 3 left and 4 up?",
      "show": "Which column vector is 3 left and 4 up?",
