  "faq": [
    {
      "q": "What is a packet?",
      "a": "A packet is a small piece of data sent across a network. Big files are split into many packets, each labelled with where it is going, where it came from and its number in the order.",
      "asks": [
        "What is packet switching?",
        "Why is data split into packets?"
      ]
    },
    {
      "q": "What does a router do?",
      "a": "A router reads the address on each packet and sends it along the best path towards its destination. Your home router links your devices to the internet; big routers pass traffic between networks.",
      "asks": [
        "What is a router for?",
        "How does a router know where to send data?"
      ]
    },
    {
      "q": "What if a packet gets lost?",
      "a": "The receiving computer notices the missing number and asks for that packet to be sent again. This is why downloads arrive complete even when the network is busy.",
      "asks": [
        "What happens to lost packets?",
        "Why do files not arrive broken?"
      ]
    },
    {
      "q": "How does data travel on the internet?",
      "a": "Data is split into packets, each sent hop by hop through routers along cables, fibre optics and radio links, and then put back together in order at the other end.",
      "asks": [
        "How does the internet work?",
        "How does a message reach another country?"
      ]
    },
    {
      "q": "What is an IP address?",
      "a": "An IP address is a number that identifies a device on the internet, like a postal address for computers. Routers use it to deliver packets to the right place.",
      "asks": [
        "What does IP stand for?",
        "Does my phone have an address?"
      ]
    }
  ],
  "facts": [
    "Packet switching, sending data in small labelled pieces, was developed in the 1960s by Paul Baran and Donald Davies.",
    "Submarine cables carry the vast majority of data travelling between continents."
  ],
