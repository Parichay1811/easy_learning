  "faq": [
    {
      "q": "What is a sustainable city?",
      "a": "A sustainable city meets the needs of the people living there today, such as homes, jobs, transport and clean water, without harming the environment or spoiling things for future generations.",
      "asks": [
        "What does sustainable mean?"
      ]
    },
    {
      "q": "How do Curitiba's buses work?",
      "a": "Since 1974 Curitiba has run buses in their own lanes, with tube-shaped stations where people pay before boarding and step straight on. This idea, called bus rapid transit, is now used in hundreds of cities.",
      "asks": [
        "What is bus rapid transit?"
      ]
    },
    {
      "q": "Why do so many people cycle in Copenhagen?",
      "a": "Copenhagen has wide bike lanes kept apart from cars, bike bridges, traffic lights timed for cyclists, flat land and short distances. Cycling is often the quickest way to get around.",
      "asks": [
        "Which city has the most cyclists?"
      ]
    },
    {
      "q": "How does Singapore recycle water?",
      "a": "Singapore cleans used water with fine filters and ultraviolet light to make NEWater, pure enough to drink. Most goes to factories, and some is added to reservoirs. It can meet up to about 40 percent of the country’s water needs.",
      "asks": [
        "What is NEWater?",
        "How does Singapore get its water?"
      ]
    },
    {
      "q": "How can a city cut its waste?",
      "a": "By reducing packaging, reusing things, recycling and composting food waste. The small town of Kamikatsu in Japan sorts its rubbish into dozens of types and recycles most of it.",
      "asks": [
        "What is a zero-waste town?"
      ]
    }
  ],
  "facts": [
    "Curitiba, Brazil, opened one of the world's first bus rapid transit systems in 1974.",
    "About half of all trips to work and study in Copenhagen are made by bicycle.",
    "Singapore's NEWater can meet up to about 40% of the country's water demand."
