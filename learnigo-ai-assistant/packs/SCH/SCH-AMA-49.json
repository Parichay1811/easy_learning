  "faq": [
    {
      "q": "What makes a relation a function?",
      "a": "Every input must have exactly one output. In a mapping diagram, each item on the left has exactly one arrow coming out.",
      "asks": [
        "Is this a function?",
        "How do I test for a function?"
      ]
    },
    {
      "q": "Can two inputs have the same output?",
      "a": "Yes. Ana and Chidi both map to March, and the rule is still a function. What is not allowed is one input with two outputs.",
      "asks": [
        "Can a function have repeated outputs?"
      ]
    },
    {
      "q": "What are domain and range?",
      "a": "The domain is the set of allowed inputs. The range is the set of outputs that actually come out. Here the domain is Ana, Ben and Chidi, and the range is March and July.",
      "asks": [
        "What is the domain of a function?"
      ]
    },
    {
      "q": "What is the vertical line test?",
      "a": "On a graph, a curve is a function if no vertical line crosses it more than once. That means each x has only one y.",
      "asks": [
        "How do you tell a function from a graph?"
      ]
    },
    {
      "q": "Why is month to person not a function?",
      "a": "March maps to both Ana and Chidi, so one input has two outputs. That breaks the rule for functions.",
      "asks": [
        "When is a mapping not a function?"
      ]
    }
  ],
  "facts": [
    "A function assigns exactly one output to each input in its domain.",
    "A graph shows a function of x if every vertical line meets it at most once."
  ],
