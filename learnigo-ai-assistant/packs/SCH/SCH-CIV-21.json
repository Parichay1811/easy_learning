  "faq": [
    {
      "q": "What does the General Assembly do?",
      "a": "It is where all 193 member countries meet, each with one vote. It debates world issues, sets the UN budget and passes resolutions, which are recommendations rather than binding laws.",
      "asks": [
        "What is the UN General Assembly?"
      ]
    },
    {
      "q": "What is a veto in the Security Council?",
      "a": "The five permanent members, China, France, Russia, the UK and the USA, can each block a Security Council decision by voting no. Supporters say it keeps big powers involved; critics say it can stop action.",
      "asks": [
        "Who has a veto at the UN?"
      ]
    },
    {
      "q": "Who is the Secretary-General?",
      "a": "The Secretary-General is the UN's chief officer, appointed by the General Assembly on the Security Council's recommendation for a five-year term. Past holders include U Thant of Myanmar, Kofi Annan of Ghana and Ban Ki-moon of South Korea.",
      "asks": [
        "Who runs the United Nations?"
      ]
    },
    {
      "q": "What is the International Court of Justice?",
      "a": "It is the UN's main court, in The Hague in the Netherlands. Its 15 judges settle legal disputes between countries and give advice on international law.",
      "asks": [
        "What is the World Court?"
      ]
    },
    {
      "q": "What do UN agencies do?",
      "a": "They do practical work around the world: UNICEF for children, WHO for health, the World Food Programme for hunger, UNESCO for education and culture, and UNHCR for refugees.",
      "asks": [
        "What is UNICEF?"
      ]
    }
  ],
  "facts": [
    "The UN Charter was signed in San Francisco on 26 June 1945, and the UN came into being on 24 October 1945.",
    "The UN has 193 member states; South Sudan was the latest to join, in 2011."
