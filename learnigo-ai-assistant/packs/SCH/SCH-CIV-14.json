  "faq": [
    {
      "q": "What is a local council?",
      "a": "A local council is the government of a town, city, district or village. It runs nearby services like bins, parks, local roads and libraries.",
      "asks": [
        "What is local government?"
      ]
    },
    {
      "q": "How are councillors chosen?",
      "a": "Residents vote for them in local elections, usually every few years. Each councillor often represents one area, called a ward.",
      "asks": [
        "Who votes for the council?"
      ]
    },
    {
      "q": "What does a mayor do?",
      "a": "A mayor leads a town or city council. Some mayors are elected directly by residents and have real power; others are chosen by councillors and have a mostly ceremonial role.",
      "asks": [
        "Who is the mayor?"
      ]
    },
    {
      "q": "What is a panchayat?",
      "a": "A panchayat is an elected village council in India. Since 1992, India's constitution has made panchayats official and kept at least one-third of seats for women.",
      "asks": [
        "What is a gram panchayat?"
      ]
    },
    {
      "q": "How do councils pay for things?",
      "a": "Through local taxes on homes and businesses, fees for things like parking, and money sent from the national or state government.",
      "asks": [
        "Where does council money come from?"
      ]
    }
  ],
  "facts": [
    "India's 73rd Amendment (1992) made elected panchayats official and reserved at least one-third of their seats for women.",
    "Many Japanese towns collect burnable, non-burnable and recyclable rubbish on different days."
  ],
