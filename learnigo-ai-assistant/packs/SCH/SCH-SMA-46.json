  "faq": [
    {
      "q": "What is a bar chart?",
      "a": "A chart with separate bars for categories, like fruits or colours. The height of each bar shows how many, and there are gaps between bars.",
      "asks": [
        "When do you use a bar chart?"
      ]
    },
    {
      "q": "What is a histogram?",
      "a": "A chart for continuous data, like height or time, grouped into ranges. The bars touch, and the area of each bar shows the frequency.",
      "asks": [
        "When do you use a histogram?"
      ]
    },
    {
      "q": "Why do histogram bars touch?",
      "a": "The ranges join with no gaps: one ends exactly where the next begins, like 140 to 150 then 150 to 160.",
      "asks": [
        "Why are there no gaps in a histogram?"
      ]
    },
    {
      "q": "What is grouped data?",
      "a": "Data put into ranges, called class intervals, so it is easier to see a pattern. Heights from 140 to 150 centimetres form one group.",
      "asks": [
        "What are class intervals?"
      ]
    },
    {
      "q": "What does the area of a histogram bar show?",
      "a": "In a histogram, the area shows the frequency. When the ranges are different widths, the height is frequency density, which is frequency divided by width.",
      "asks": [
        "What is frequency density?"
      ]
    }
  ],
  "facts": [
    "Histograms are used for continuous data; bar charts are used for categories.",
    "Frequency density = frequency ÷ class width."
  ],
