  "faq": [
    {
      "q": "Why do plants need light?",
      "a": "Light is the energy source for photosynthesis. Chlorophyll in chloroplasts absorbs mainly red and blue light and uses it to join carbon dioxide and water together.",
      "asks": [
        "Tell me about light energy"
      ]
    },
    {
      "q": "Where does the carbon dioxide come from?",
      "a": "It diffuses from the air into the leaf through tiny pores called stomata, mostly on the underside of the leaf.",
      "asks": [
        "Tell me about carbon dioxide"
      ]
    },
    {
      "q": "How does water reach the leaf?",
      "a": "Water enters the roots, mainly through root hair cells, and travels up the stem in xylem tubes to the leaves.",
      "asks": [
        "Tell me about water"
      ]
    },
    {
      "q": "What does the plant do with glucose?",
      "a": "Plants use glucose for respiration, store it as starch, turn it into cellulose for cell walls, and combine it with minerals to make proteins and oils.",
      "asks": [
        "Tell me about glucose"
      ]
    },
    {
      "q": "Where does the oxygen come from?",
      "a": "The oxygen given off in photosynthesis comes from splitting water molecules. Some is used by the plant for respiration and the rest leaves through the stomata.",
      "asks": [
        "Tell me about oxygen"
      ]
    }
  ],
  "facts": [
    "Word equation: carbon dioxide + water → glucose + oxygen, using light energy absorbed by chlorophyll.",
    "Balanced equation: 6CO2 + 6H2O → C6H12O6 + 6O2.",
    "The oxygen released in photosynthesis comes from water, not from carbon dioxide."
  ],
