  "faq": [
    {
      "q": "What is a mole?",
      "a": "A mole is the chemist's counting unit. One mole of any substance contains 6.02 times 10 to the 23 particles, and its mass in grams equals its relative formula mass.",
      "asks": [
        "Define mole in chemistry"
      ]
    },
    {
      "q": "How do you calculate moles?",
      "a": "Moles equal mass in grams divided by relative formula mass. For 36 grams of water, 36 divided by 18 gives 2 moles.",
      "asks": [
        "How do you work out moles from mass?"
      ]
    },
    {
      "q": "What is relative formula mass?",
      "a": "It is the sum of the relative atomic masses of all the atoms in a formula. For water, H2O, it is 1 plus 1 plus 16, which is 18.",
      "asks": [
        "How do you work out Mr?"
      ]
    },
    {
      "q": "What is Avogadro's number?",
      "a": "Avogadro's number is 6.02 times 10 to the 23. It is the number of particles in one mole of any substance.",
      "asks": [
        "What is the Avogadro constant?"
      ]
    },
    {
      "q": "Why do chemists use moles?",
      "a": "Atoms are far too small to count, but weighing is easy. Moles turn a mass you can weigh into a number of particles, so you can work out how much of each chemical reacts.",
      "asks": [
        "What is the point of the mole?"
      ]
    }
