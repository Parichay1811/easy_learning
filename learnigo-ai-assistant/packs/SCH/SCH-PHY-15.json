  "faq": [
    {
      "q": "What is the kinetic store?",
      "a": "The kinetic store is energy an object has because it is moving. It grows with mass and grows a lot with speed.",
      "asks": [
        "kinetic energy meaning"
      ]
    },
    {
      "q": "What is the gravitational store?",
      "a": "The gravitational potential store is energy an object has because of its height. Lifting something higher fills this store.",
      "asks": [
        "gravitational potential energy meaning"
      ]
    },
    {
      "q": "What is the chemical store?",
      "a": "The chemical store is energy held in substances like food, fuels and batteries, released by chemical reactions.",
      "asks": [
        "chemical energy meaning"
      ]
    },
    {
      "q": "What are the energy stores?",
      "a": "There are eight: kinetic, gravitational potential, elastic potential, thermal, chemical, magnetic, electrostatic and nuclear.",
      "asks": [
        "list of energy stores"
      ]
    },
    {
      "q": "Can energy be destroyed?",
      "a": "No. Energy can only be transferred from one store to another. The total amount always stays the same.",
      "asks": [
