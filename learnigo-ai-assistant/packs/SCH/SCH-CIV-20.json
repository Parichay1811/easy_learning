  "faq": [
    {
      "q": "What is citizenship by birth?",
      "a": "In some countries, being born on their territory makes you a citizen, whoever your parents are. The USA, Canada, Brazil, Mexico and Argentina follow this rule.",
      "asks": [
        "What is jus soli?"
      ]
    },
    {
      "q": "What is citizenship by descent?",
      "a": "It means you are a citizen because one or both parents are, even if you were born abroad. Japan, China, India and Nigeria mainly use this rule.",
      "asks": [
        "What is jus sanguinis?"
      ]
    },
    {
      "q": "What is naturalisation?",
      "a": "Naturalisation is becoming a citizen of a new country as an adult or child, usually after living there for several years, passing tests and taking an oath of loyalty.",
      "asks": [
        "How do immigrants become citizens?"
      ]
    },
    {
      "q": "Can you have two citizenships?",
      "a": "Many countries, like the UK, the USA, Brazil and Mexico, allow dual citizenship. Others, such as India, China and Japan, generally do not.",
      "asks": [
        "What is dual citizenship?"
      ]
    },
    {
      "q": "What does stateless mean?",
      "a": "A stateless person is not recognised as a citizen by any country, which can make it hard to go to school, work or travel. The UN refugee agency runs campaigns to end statelessness.",
      "asks": [
        "Can someone have no country?"
      ]
    }
  ],
  "facts": [
    "The USA, Canada, Brazil and Mexico give citizenship to almost anyone born on their soil.",
    "India does not allow dual citizenship; it offers Overseas Citizenship of India (OCI) instead."
