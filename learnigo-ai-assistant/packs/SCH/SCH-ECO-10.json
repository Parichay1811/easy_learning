  "faq": [
    {
      "q": "What is a market?",
      "a": "A market is any place or system where buyers and sellers meet to trade, from a village bazaar to a stock exchange or an app.",
      "asks": [
        "What does market mean in economics?"
      ]
    },
    {
      "q": "Who sets the price in a market?",
      "a": "Buyers and sellers together. If a price is too high, buyers walk away; if it is too low, goods sell out. The price settles where both sides agree.",
      "asks": [
        "How is a market price decided?"
      ]
    },
    {
      "q": "Is an online shop a market?",
      "a": "Yes. A market does not need a building. Online shops, apps and marketplaces connect buyers and sellers across a city or the whole world.",
      "asks": [
        "Are websites markets?"
      ]
    },
    {
      "q": "What is the difference between goods and services?",
      "a": "Goods are things you can touch, like rice, shoes or phones. Services are work done for you, like a haircut, a bus ride or a lesson.",
      "asks": [
        "What are goods?"
      ]
    },
    {
      "q": "What is bargaining?",
      "a": "Bargaining, or haggling, is when a buyer and seller discuss the price until they agree. It is common in markets in India, Egypt, Morocco and Thailand.",
      "asks": [
        "How do you haggle?"
      ]
    }
  ],
  "facts": [
    "Istanbul's Grand Bazaar, begun in the 1450s, has about 60 covered streets and around 4,000 shops.",
