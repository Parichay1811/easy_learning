  "faq": [
    {
      "q": "Who was Aryabhata?",
      "a": "An Indian mathematician and astronomer born in 476 CE. His book, the Aryabhatiya, said the Earth turns on its axis, explained eclipses, and gave pi as about 3.1416.",
      "asks": [
        "What did Aryabhata discover?"
      ]
    },
    {
      "q": "Did India invent the zero?",
      "a": "Indian mathematicians developed zero as a number and the place-value system with ten digits. Brahmagupta wrote rules for working with zero in 628 CE. The system spread through Arab scholars, so Europeans called the digits Arabic numerals.",
      "asks": [
        "Where does zero come from?"
      ]
    },
    {
      "q": "What was Nalanda?",
      "a": "A great centre of learning in Bihar, India, founded around the 400s CE. At its peak it had thousands of students and a huge library, until it was destroyed around 1200 CE.",
      "asks": [
        "Was Nalanda a university?"
      ]
    },
    {
      "q": "Why hasn't the Delhi iron pillar rusted?",
      "a": "Its iron contains phosphorus, which helps a thin, tough protective layer form on the surface. Delhi's fairly dry air helps too.",
      "asks": [
        "Why is the iron pillar rust free?"
      ]
    },
    {
      "q": "Why is the Gupta period called a golden age?",
      "a": "Because of its peace and wealth, and its achievements in maths, astronomy, literature like Kalidasa's plays, art and learning. Some historians note that the golden picture fits rulers and the rich better than everyone.",
      "asks": [
        "What was the Gupta golden age?"
      ]
    }
  ],
  "facts": [
    "Aryabhata wrote the Aryabhatiya in 499 CE, when he was 23.",
