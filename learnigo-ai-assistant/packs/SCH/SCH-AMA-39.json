  "faq": [
    {
      "q": "What is a normal distribution?",
      "a": "A bell-shaped spread of data, the same on both sides of the mean, where values near the middle are common and far ones are rare.",
      "asks": [
        "What is a bell curve?"
      ]
    },
    {
      "q": "What does standard deviation mean?",
      "a": "It measures how spread out the data is: roughly the typical distance from the mean. A small SD gives a tall, thin bell; a large SD gives a low, wide one.",
      "asks": [
        "What is SD in statistics?"
      ]
    },
    {
      "q": "What is the 68 95 99.7 rule?",
      "a": "In a normal distribution, about 68 percent of values lie within 1 standard deviation of the mean, 95 percent within 2, and 99.7 percent within 3.",
      "asks": [
        "What is the empirical rule?"
      ]
    },
    {
      "q": "Why are so many things normally distributed?",
      "a": "When a value comes from adding up many small random effects, like genes and food for height, the total tends to form a bell curve. This is the central limit theorem.",
      "asks": [
        "Why does the bell curve appear so often?"
      ]
    },
    {
      "q": "What is a z-score?",
      "a": "A z-score says how many standard deviations a value is from the mean. A height of 173 centimetres, with mean 165 and SD 8, has z equal to 1.",
      "asks": [
        "How do you work out a z-score?"
      ]
    }
  ],
  "facts": [
    "In a normal distribution about 68% of values lie within 1 SD of the mean, 95% within 2 SD and 99.7% within 3 SD.",
    "The normal curve is symmetric about its mean, which equals its median and mode."
