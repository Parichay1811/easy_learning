  "faq": [
    {
      "q": "What is the transformer equation?",
      "a": "Secondary voltage over primary voltage equals secondary turns over primary turns: Vs over Vp equals Ns over Np.",
      "asks": [
        "How do you calculate transformer output voltage?"
      ]
    },
    {
      "q": "What does the iron core do?",
      "a": "It carries the changing magnetic field from the primary coil to the secondary coil, so very little is lost.",
      "asks": [
        "Why do transformers have an iron core?"
      ]
    },
    {
      "q": "What is a step-down transformer?",
      "a": "One with fewer turns on the secondary coil than the primary, so the output voltage is lower than the input.",
      "asks": [
        "step-up vs step-down transformer"
      ]
    },
    {
      "q": "Why do transformers only work with AC?",
      "a": "They need a changing magnetic field to induce a voltage. Direct current gives a steady field, so nothing is induced.",
      "asks": [
        "Can a transformer work on DC?"
      ]
    },
    {
      "q": "Why is electricity sent at high voltage?",
      "a": "For the same power, higher voltage means lower current, and lower current wastes much less energy heating the cables.",
      "asks": [
        "Why do power lines use high voltage?"
      ]
    }
  ],
  "facts": [
    "Vs / Vp = Ns / Np for an ideal transformer.",
    "China operates ultra-high-voltage lines at up to 1100 kV."
  ],
