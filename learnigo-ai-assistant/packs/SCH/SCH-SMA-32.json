  "faq": [
    {
      "q": "What is an equilateral triangle?",
      "a": "A triangle with all 3 sides equal. All 3 angles are equal too, each 60 degrees.",
      "asks": [
        "Equilateral meaning"
      ]
    },
    {
      "q": "What is an isosceles triangle?",
      "a": "A triangle with 2 equal sides. The two angles opposite those sides are also equal.",
      "asks": [
        "Isosceles meaning"
      ]
    },
    {
      "q": "What is a scalene triangle?",
      "a": "A triangle where no sides are the same length and no angles are the same size.",
      "asks": [
        "Scalene meaning"
      ]
    },
    {
      "q": "What is a right-angled triangle?",
      "a": "A triangle with one angle of exactly 90 degrees. The longest side, opposite the right angle, is called the hypotenuse.",
      "asks": [
        "What is a right triangle?"
      ]
    },
    {
      "q": "Why are triangles used in bridges?",
      "a": "A triangle is rigid: if its sides cannot change length, its shape cannot change. A square can be pushed into a diamond, but a triangle cannot.",
      "asks": [
        "Why are triangles strong?"
      ]
    }
