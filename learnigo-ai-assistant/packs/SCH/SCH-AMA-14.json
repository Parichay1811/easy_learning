  "faq": [
    {
      "q": "What is half-life?",
      "a": "Half-life is the time it takes for half of a radioactive substance to decay. For carbon-14 it is about 5730 years.",
      "asks": [
        "What does half-life mean?"
      ]
    },
    {
      "q": "How does carbon dating work?",
      "a": "Living things keep a steady level of carbon-14. After death it halves every 5730 years, so measuring what is left tells you how long ago the thing died.",
      "asks": [
        "What is radiocarbon dating?"
      ]
    },
    {
      "q": "How much carbon-14 is left after two half-lives?",
      "a": "One quarter. Half goes in the first half-life, then half of what is left goes in the second.",
      "asks": [
