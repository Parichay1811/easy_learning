  "faq": [
    {
      "q": "What is exporting?",
      "a": "Exporting is selling goods or services to another country. Brazil exports coffee and soya; India exports software services and medicines.",
      "asks": [
        "What is an export?"
      ]
    },
    {
      "q": "What is importing?",
      "a": "Importing is buying goods or services from another country, like Japan buying oil from Saudi Arabia.",
      "asks": [
        "What is an import?"
      ]
    },
    {
      "q": "Why can't a country make everything itself?",
      "a": "Countries have different climates, resources and skills. Growing coffee in Norway or finding oil in Japan would be very costly, so trading is cheaper and gives more choice.",
      "asks": [
        "Why do countries need each other?"
      ]
    },
    {
      "q": "Is trade always good?",
      "a": "Trade usually brings lower prices, more choice and more jobs in exporting industries. But some local firms lose out to imports, and depending on others can be risky in a crisis, so countries debate how open to be.",
      "asks": [
        "What are the downsides of trade?"
      ]
    },
    {
      "q": "What does Brazil export?",
      "a": "Brazil is a top exporter of coffee, soya beans, sugar, beef, iron ore and oil, and it also builds aircraft.",
      "asks": [
        "What is Brazil famous for selling?"
      ]
    }
