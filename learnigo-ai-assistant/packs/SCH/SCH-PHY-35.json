  "faq": [
    {
      "q": "Which way do magnetic field lines go?",
      "a": "Outside a magnet, field lines go from the north pole to the south pole.",
      "asks": [
        "magnetic field direction"
      ]
    },
    {
      "q": "What is Fleming's left-hand rule?",
      "a": "Hold thumb, first and second fingers at right angles. First finger is field, second finger is current, thumb is the motion or force.",
      "asks": [
        "left hand rule for motors"
      ]
    },
    {
      "q": "How do you make the force bigger?",
      "a": "Use a bigger current, a stronger magnet or a longer wire in the field, such as more turns of coil.",
      "asks": [
        "How do you increase the motor effect?"
      ]
    },
    {
      "q": "What is the motor effect?",
      "a": "A wire carrying a current in a magnetic field feels a force. That force is the motor effect.",
      "asks": [
        "motor effect meaning"
      ]
    },
    {
      "q": "How do you reverse the force on the wire?",
      "a": "Reverse the current or reverse the magnetic field. Reversing both keeps the force the same way.",
      "asks": [
        "How do you make a motor spin the other way?"
      ]
    }
