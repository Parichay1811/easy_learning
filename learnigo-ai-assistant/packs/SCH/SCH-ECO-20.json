  "faq": [
    {
      "q": "Who are households?",
      "a": "Households are people living together, like a family, who earn income by working and spend it on goods and services.",
      "asks": [
        "What is a household in economics?"
      ]
    },
    {
      "q": "What are firms?",
      "a": "Firms are businesses, from a street food stall to a car maker, that hire workers, make goods or services and sell them.",
      "asks": [
        "What is a firm?"
      ]
    },
    {
      "q": "What are leakages and injections?",
      "a": "Leakages are money leaving the circle: savings, taxes and spending on imports. Injections are money entering: investment, government spending and exports. If injections beat leakages, the economy grows.",
      "asks": [
        "What leaks out of the circular flow?"
      ]
    },
    {
      "q": "Why does spending matter for jobs?",
      "a": "One person's spending is another person's income. If people spend less, firms sell less and may cut jobs, which cuts incomes and spending again.",
      "asks": [
        "Why does spending help the economy?"
      ]
    },
    {
      "q": "Who invented the circular flow?",
      "a": "The French doctor and economist Francois Quesnay drew his Tableau economique in 1758, showing money flowing between groups in society. Later economists turned it into the circular flow diagram.",
      "asks": [
        "What was the Tableau economique?"
      ]
    }
  ],
  "facts": [
    "Francois Quesnay published his Tableau economique in 1758.",
    "In the simple circular flow, total spending equals total income for the whole economy."
  ],
