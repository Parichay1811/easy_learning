  "faq": [
    {
      "q": "Why does a sphere roll?",
      "a": "A sphere is curved all over with no flat faces, so it touches the ground at just one point and tips over easily in any direction.",
      "asks": [
        "Why do balls roll?"
      ]
    },
    {
      "q": "Why can a cube stack?",
      "a": "A cube has 6 flat square faces. Flat faces sit firmly on top of each other without wobbling, so cubes stack into towers.",
      "asks": [
        "Why do boxes stack?"
      ]
    },
    {
      "q": "Why can a cylinder roll and stack?",
      "a": "A cylinder has 2 flat circle faces and one curved surface. On a flat face it stands still and stacks; on its curved side it rolls.",
      "asks": [
        "Can a tin can roll and stack?"
      ]
    },
    {
      "q": "What is a cone?",
      "a": "A cone is a 3D shape with one flat circle face, a curved surface and a point at the top called a vertex. A party hat and an ice cream cone are cones.",
