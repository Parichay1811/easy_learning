  "faq": [
    {
      "q": "Why did the Aztecs build on a lake?",
      "a": "A Mexica legend says they were to settle where they saw an eagle perched on a cactus, an image now on Mexico's flag. The island was also easy to defend, and the lake gave fish, birds and canoe transport.",
      "asks": [
        "Why is Tenochtitlan on an island?"
      ]
    },
    {
      "q": "What were the causeways?",
      "a": "Raised stone and earth roads across Lake Texcoco linking the island to the shore. Gaps with removable wooden bridges let canoes pass and helped defend the city.",
      "asks": [
        "How did people reach Tenochtitlan?"
      ]
    },
    {
      "q": "What is a chinampa?",
      "a": "A rectangle of farmland built up in shallow lake water from layers of mud and plants, held by stakes and willow trees. Some are still farmed at Xochimilco in Mexico City.",
      "asks": [
        "What were the floating gardens?"
      ]
    },
    {
      "q": "How did Tenochtitlan get fresh water?",
      "a": "A stone aqueduct carried spring water several kilometres from Chapultepec hill into the city. It had two channels so one could be repaired while the other worked.",
      "asks": [
        "Where did the Aztecs get drinking water?"
      ]
    },
    {
      "q": "How did Tenochtitlan fall?",
      "a": "In 1521 Spanish forces under Hernan Cortes, with many thousands of Indigenous allies such as the Tlaxcalans, besieged the city. A smallpox epidemic had already killed many of its people.",
      "asks": [
        "Who conquered the Aztecs?"
      ]
    }
  ],
  "facts": [
    "Tenochtitlan was founded in 1325 on an island in Lake Texcoco.",
    "Chinampas are still farmed at Xochimilco, part of a UNESCO World Heritage Site.",
    "The eagle on a cactus from the founding legend appears on Mexico's flag."
  ],
