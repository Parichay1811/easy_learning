  "faq": [
    {
      "q": "What was the triangular trade?",
      "a": "A three-part trade route across the Atlantic. Ships took goods from Europe to West Africa, carried enslaved Africans to the Americas, and brought sugar, cotton and tobacco back to Europe.",
      "asks": [
        "How did the triangular trade work?"
      ]
    },
    {
      "q": "What was the Middle Passage?",
      "a": "The middle part of the triangle: the forced voyage of enslaved Africans across the Atlantic, lasting about two months. Conditions were brutal, and more than 1.8 million people died at sea.",
      "asks": [
        "What happened on slave ships?"
      ]
    },
    {
      "q": "Where were enslaved Africans taken?",
      "a": "Most went to Brazil and the Caribbean to work on sugar plantations and in mines. About 4.9 million were taken to Brazil alone, and about 390,000 to mainland North America.",
      "asks": [
        "Where did slave ships go?"
      ]
    },
    {
      "q": "Did enslaved people resist?",
      "a": "Yes, always. They rebelled on ships, ran away, formed free communities called maroon societies, kept their cultures alive, and led revolts, including the Haitian Revolution of 1791.",
      "asks": [
        "How did enslaved Africans fight back?"
      ]
    },
    {
      "q": "How many people were taken in the Atlantic slave trade?",
      "a": "Historians estimate about 12.5 million Africans were forced onto ships between the 1500s and the 1860s, and about 10.7 million survived the voyage.",
      "asks": [
        "How many Africans were enslaved?"
      ]
    }
