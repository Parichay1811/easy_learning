  "faq": [
    {
      "q": "What does a conductor do?",
      "a": "The conductor leads the orchestra: showing the beat and speed with a baton, bringing in each section, shaping how loud or soft it plays, and deciding how the music should feel.",
      "asks": [
        "Why does an orchestra need a conductor?",
        "What is a baton for?"
      ]
    },
    {
      "q": "How is an orchestra arranged?",
      "a": "Usually strings sit at the front in a semicircle, woodwind in the middle, brass behind them and percussion at the back, with the conductor at the front facing everyone.",
      "asks": [
        "Orchestra seating plan",
        "Where do instruments sit in an orchestra?"
      ]
    },
    {
      "q": "Why do the violins sit at the front?",
      "a": "Strings are the largest and softest section, so they sit nearest the audience to be heard. Violins usually sit on the conductor's left, and cellos and basses on the right.",
      "asks": [
        "Why are strings in front?",
        "Where do the cellos sit?"
      ]
    },
    {
      "q": "Why do brass players sit at the back?",
      "a": "Brass and percussion are the loudest instruments, so sitting at the back keeps them from covering the softer instruments and helps the sound blend.",
      "asks": [
        "Why is percussion at the back?",
        "Why are the loud instruments at the back?"
      ]
    },
    {
      "q": "How many players are in an orchestra?",
      "a": "A full symphony orchestra often has 80 to 100 players. A smaller chamber orchestra may have around 15 to 40.",
      "asks": [
        "How big is a symphony orchestra?",
        "What is a chamber orchestra?"
      ]
    }
  ],
  "facts": [
    "In a full symphony orchestra the strings usually make up more than half of the players.",
    "The usual layout places strings at the front, woodwind behind them, then brass, with percussion at the back."
  ],
