  "faq": [
    {
      "q": "What is a cross-section?",
      "a": "It is the shape you see if you slice straight through a solid. In a prism it is the same shape all the way along, like the end of a pencil.",
      "asks": [
        "What does cross-section mean?"
      ]
    },
    {
      "q": "Why do you multiply the area by the length?",
      "a": "The cross-section is one layer. The length tells you how many layers are stacked, so area times length counts every cube.",
      "asks": [
        "Why is volume area times length?"
      ]
    },
    {
      "q": "What is a prism?",
      "a": "A solid with the same cross-section all along its length, like a box, a hexagon pencil or a triangle-shaped chocolate bar. Cones and spheres are not prisms.",
      "asks": [
        "Is a cylinder a prism?"
      ]
    },
    {
      "q": "What units is volume measured in?",
      "a": "Cubic units, like cubic centimetres or cubic metres. 1,000 cubic centimetres is 1 litre.",
