  "faq": [
    {
      "q": "Where did Harappan cities get water?",
      "a": "From wells lined with baked bricks. Mohenjo-daro may have had around 700 wells, so most neighbourhoods had water close by.",
      "asks": [
        "How did Mohenjo-daro get water?"
      ]
    },
    {
      "q": "Did Indus Valley houses have bathrooms?",
      "a": "Many did. Archaeologists found bathing floors of tightly fitted bricks, and some toilets, linked by pipes to the street drains.",
      "asks": [
        "Did Harappan homes have toilets?"
      ]
    },
    {
      "q": "Why were the Indus drains covered?",
      "a": "Lids kept the smell in, stopped people and animals falling in, and kept rubbish out. They could be lifted so workers could clean the drains.",
      "asks": [
        "Why did the drains have lids?"
      ]
    },
    {
      "q": "What is a soak pit?",
      "a": "A soak pit is a hole where dirty water slows down, so mud and rubbish sink to the bottom. Cleaners emptied them so the drains kept flowing.",
      "asks": [
        "What were the pits in the drains for?"
      ]
    },
    {
      "q": "What was the Great Bath?",
      "a": "A large brick pool at Mohenjo-daro, about 12 metres long, 7 metres wide and 2.4 metres deep, made watertight with bitumen. Many experts think it was used for special ritual bathing.",
      "asks": [
        "What is the Great Bath of Mohenjo-daro?"
      ]
    }
  ],
