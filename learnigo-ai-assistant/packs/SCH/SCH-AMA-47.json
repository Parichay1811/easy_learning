  "faq": [
    {
      "q": "How do you draw an ellipse with string?",
      "a": "Put two pins in a board, loop a string round them, and move a pencil round keeping the string tight. The pencil traces an ellipse.",
      "asks": [
        "What is the string method for an ellipse?"
      ]
    },
    {
      "q": "What are the foci of an ellipse?",
      "a": "The two fixed points inside an ellipse. For every point on the ellipse, the distances to the two foci add up to the same total.",
      "asks": [
        "What is a focus of an ellipse?"
      ]
    },
    {
      "q": "Why do planets move in ellipses?",
      "a": "Gravity from the Sun pulls with a force that weakens with the square of distance. Newton showed that such a force makes closed orbits that are ellipses, with the Sun at a focus.",
      "asks": [
        "What is Kepler's first law?"
      ]
    },
    {
      "q": "What happens when the two foci are in the same place?",
      "a": "The distances to both foci are the same, so each is half the string. Every point is the same distance from the centre: a circle.",
      "asks": [
        "Is a circle an ellipse?"
      ]
    },
    {
      "q": "What is the equation of an ellipse?",
      "a": "x squared over a squared plus y squared over b squared equals 1, where a and b are half the width and half the height.",
      "asks": [
        "How do you write an ellipse equation?"
      ]
    }
  ],
  "facts": [
    "For every point on an ellipse, the sum of the distances to the two foci is constant.",
    "Kepler's first law (1609): each planet orbits the Sun in an ellipse with the Sun at one focus."
  ],
