  "faq": [
    {
      "q": "What is an expression?",
      "a": "An expression has numbers, letters and operations but no equals sign, like 3x plus 2. You can simplify it, or find its value when you know x.",
      "asks": [
        "Is 3x + 2 an expression?"
      ]
    },
    {
      "q": "What is an equation?",
      "a": "An equation says two things are equal, and it is true only for some values. 3x plus 2 equals 11 is true when x is 3.",
      "asks": [
        "What makes something an equation?"
      ]
    },
    {
      "q": "What is a formula?",
      "a": "A formula is a rule that links quantities, like A equals l times w for the area of a rectangle. You put in numbers to get the answer.",
      "asks": [
        "Is A = l × w a formula?"
      ]
    },
    {
      "q": "What is an identity?",
      "a": "An identity is true for every value of the letter, like x plus x equals 2x. It is sometimes written with three lines instead of an equals sign.",
      "asks": [
        "Is x + x = 2x an equation?"
      ]
    },
    {
      "q": "Why do we use letters in algebra?",
      "a": "A letter stands for a number we do not know yet, or for any number at all. It lets you write a rule once instead of for every case.",
      "asks": [
        "What does x stand for?"
      ]
    }
  ],
  "facts": [
    "The equals sign was introduced by the Welsh mathematician Robert Recorde in 1557.",
    "Recorde drew two parallel lines because he felt no two things could be more equal."
