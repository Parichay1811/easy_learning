  "faq": [
    {
      "q": "What is the chance of exactly 5 heads in 10 flips?",
      "a": "10 choose 5 is 252, out of 1024 equally likely runs. So the chance is 252 over 1024, about 0.246, roughly one in four.",
      "asks": [
        "Probability of 5 heads in 10 tosses?"
      ]
    },
    {
      "q": "Why is 5 heads the most likely?",
      "a": "There are more ways to pick 5 flips out of 10 than any other number. Half heads and half tails can happen in the most different orders.",
      "asks": [
        "Why is the middle bar tallest?"
      ]
    },
    {
      "q": "What is the binomial distribution?",
      "a": "It gives the probability of each number of successes when you repeat the same yes-or-no trial a fixed number of times, with the same chance each time.",
      "asks": [
        "Explain the binomial distribution simply"
      ]
    },
    {
      "q": "What is the formula for binomial probability?",
      "a": "The chance of k successes in n tries is n choose k times p to the k times 1 minus p to the n minus k, where p is the chance of success each try.",
      "asks": [
        "What is the binomial formula?"
      ]
    },
    {
      "q": "What is the expected number of heads in 10 flips?",
      "a": "n times p, so 10 times one half, which is 5 heads on average.",
      "asks": [
        "What is the mean of a binomial distribution?"
      ]
    }
  ],
