  "faq": [
    {
      "q": "What is a government?",
      "a": "A government is the group of people who run a country, a state or a town. They make decisions, make laws and organise services like schools and roads.",
      "asks": [
        "Who runs the country?"
      ]
    },
    {
      "q": "Who pays for schools?",
      "a": "Government schools are paid for with taxes, money collected from people and businesses. Some families choose private schools and pay for them themselves.",
      "asks": [
        "Why is school free?"
      ]
    },
    {
      "q": "What are public services?",
      "a": "Public services are things the government provides for everyone, such as schools, hospitals, roads, clean water, police and fire crews.",
      "asks": [
        "What services does the government give?"
      ]
    },
    {
      "q": "Where does government money come from?",
      "a": "Mostly from taxes: people pay part of their wages, and shops add sales tax to prices. Some countries also earn money from selling oil, gas or minerals.",
      "asks": [
        "How does the government get money?"
      ]
    },
    {
      "q": "Does every government do the same things?",
      "a": "No. Some governments, like Norway's, provide lots of services and collect high taxes. Others, like Singapore's, keep taxes lower and ask people to save for things like health care. People argue about the best balance.",
      "asks": [
        "Why are services different in other countries?"
      ]
    }
  ],
  "facts": [
    "The UN goal for 2030 is that every girl and boy completes free primary and secondary school.",
    "The UK's National Health Service, paid for mainly by taxes, began in 1948."
  ],
