  "faq": [
    {
      "q": "What is arable farming?",
      "a": "Arable farming means growing crops in ploughed fields, such as wheat, rice, maize and vegetables. It needs fairly flat land, good soil and enough water.",
      "asks": [
        "What does arable mean?"
      ]
    },
    {
      "q": "What is pastoral farming?",
      "a": "Pastoral farming means raising animals, such as sheep, cattle, goats and yaks, for meat, milk and wool. Some herders, like many in Mongolia, move with their animals to find fresh grass.",
      "asks": [
        "What is nomadic herding?"
      ]
    },
    {
      "q": "What is plantation farming?",
      "a": "A plantation is a large estate in a warm country growing one cash crop, such as tea, coffee, cocoa, sugar cane, rubber or oil palm, mostly to sell abroad. Many plantations began in colonial times.",
      "asks": [
        "What is a plantation?",
        "Where does tea come from?"
      ]
    },
    {
      "q": "What is the difference between subsistence and commercial farming?",
      "a": "Subsistence farmers grow food mainly to feed their own family, with little left to sell. Commercial farmers grow crops or raise animals to sell for profit, often using machines.",
      "asks": [
        "What is subsistence farming?"
      ]
    },
    {
      "q": "What is mixed farming?",
      "a": "Mixed farming combines crops and animals on one farm. Manure fertilises the fields, animals eat crop leftovers, and if one part fails the other still brings food or money.",
      "asks": [
        "Why keep animals and crops together?"
      ]
    }
