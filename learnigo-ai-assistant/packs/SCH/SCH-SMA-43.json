  "faq": [
    {
      "q": "What is the mean?",
      "a": "Add all the values and divide by how many there are. 2, 3, 3, 5 and 7 add to 20, and 20 divided by 5 is 4.",
      "asks": [
        "How do you find the mean?"
      ]
    },
    {
      "q": "What is the median?",
      "a": "Put the values in order and pick the middle one. For 2, 3, 3, 5, 7 the median is 3.",
      "asks": [
        "How do you find the median?"
      ]
    },
    {
      "q": "What is the mode?",
      "a": "The value that appears most often. In 2, 3, 3, 5, 7 the mode is 3.",
      "asks": [
        "How do you find the mode?"
      ]
    },
    {
      "q": "How do you find the median of an even number of values?",
      "a": "Find the two middle values and take the number halfway between them. For 2, 4, 6, 8 the median is halfway between 4 and 6, which is 5.",
      "asks": [
        "Median with two middle numbers"
      ]
    },
    {
      "q": "Which average is best?",
      "a": "The mean uses every value. The median is better when there are extreme values. The mode is best for things like the most popular size or colour.",
      "asks": [
        "When do you use each average?"
      ]
    }
