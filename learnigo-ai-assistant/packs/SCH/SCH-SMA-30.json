  "faq": [
    {
      "q": "What are alternate angles?",
      "a": "They sit inside a Z shape made by a line crossing two parallel lines. Alternate angles are equal.",
      "asks": [
        "What is a Z angle?"
      ]
    },
    {
      "q": "What are corresponding angles?",
      "a": "They are in the same position at each crossing, inside an F shape. Corresponding angles are equal.",
      "asks": [
        "What is an F angle?"
      ]
    },
    {
      "q": "What are co-interior angles?",
      "a": "They sit inside a C or U shape between the parallel lines. Co-interior angles add up to 180 degrees.",
      "asks": [
        "What is a C angle?",
        "Do co-interior angles add to 180?"
      ]
    },
    {
      "q": "What are vertically opposite angles?",
      "a": "Where two lines cross they make an X. The angles opposite each other are equal.",
      "asks": [
        "What is an X angle?"
      ]
    },
    {
      "q": "How did Eratosthenes use parallel lines?",
      "a": "He treated sun rays as parallel. The shadow angle at Alexandria equalled the angle between Alexandria and Syene at the Earth's centre, as alternate angles, and from that he worked out the Earth's size.",
      "asks": [
        "How was the size of the Earth first measured?"
      ]
    }
