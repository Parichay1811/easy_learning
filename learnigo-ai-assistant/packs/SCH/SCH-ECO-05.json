  "faq": [
    {
      "q": "Is my money safe in a bank?",
      "a": "Usually yes. Banks are checked by the central bank, and many countries insure deposits up to a limit, such as 5 lakh rupees in India or 250,000 dollars in the USA, if a bank fails.",
      "asks": [
        "What if a bank goes bust?"
      ]
    },
    {
      "q": "How does a bank make money?",
      "a": "Mainly by charging borrowers a higher interest rate than it pays savers. It also charges fees for services like cards and transfers.",
      "asks": [
        "Why do banks pay interest?"
      ]
    },
    {
      "q": "What is a loan?",
      "a": "A loan is money you borrow and must pay back over time, usually with interest. People take loans for homes, education, cars or starting a business.",
      "asks": [
        "How do loans work?"
      ]
    },
    {
      "q": "What does a central bank do?",
      "a": "A central bank, like the Reserve Bank of India, the Bank of Japan or the US Federal Reserve, issues the currency, watches over banks and sets a key interest rate to keep prices steady.",
      "asks": [
        "What is the Reserve Bank?"
      ]
    },
    {
      "q": "What is Islamic banking?",
      "a": "Islamic banks follow rules that forbid charging or paying interest. Instead, the bank and customer share profits or the bank buys an item and sells it on at an agreed price. It is common in Malaysia, the Gulf and Pakistan.",
      "asks": [
        "Can banks work without interest?"
      ]
    }
  ],
  "facts": [
    "Muhammad Yunus and Grameen Bank shared the 2006 Nobel Peace Prize for microcredit.",
    "India's deposit insurance covers up to 5 lakh rupees per depositor per bank."
  ],
