  "faq": [
    {
      "q": "What is a language family?",
      "a": "A language family is a group of languages that all grew from one older language, like Spanish, French and Italian, which all come from Latin.",
      "asks": [
        "Language family meaning"
      ]
    },
    {
      "q": "What is Proto-Indo-European?",
      "a": "Proto-Indo-European is the ancestor of languages from English to Hindi. It was spoken more than 5,000 years ago and never written down; linguists rebuild it by comparing its descendants.",
      "asks": [
        "PIE language"
      ]
    },
    {
      "q": "Are English and Hindi related?",
      "a": "Yes. Both are Indo-European languages, distant cousins. Compare English mother, Hindi mātā and Sanskrit mātṛ, or English name and Hindi nām.",
      "asks": [
        "English Hindi cognates"
      ]
    },
    {
      "q": "What is a cognate?",
      "a": "A cognate is a word that shares an origin with a word in another language, like English night, German Nacht and Spanish noche.",
      "asks": [
        "Cognate meaning"
      ]
    },
    {
      "q": "Is there a language with no family?",
      "a": "Yes. Basque, spoken in Spain and France, is called a language isolate, because no related language has been found.",
      "asks": [
        "Language isolate"
      ]
    }
  ],
  "facts": [
    "Ethnologue counts about 7,000 living languages in the world.",
