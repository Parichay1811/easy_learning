  "faq": [
    {
      "q": "What does calm feel like?",
      "a": "Calm feels soft and steady. Your breathing is slow, and your body is relaxed. You feel ready to learn.",
      "asks": [
        "Tell me about Calm",
        "What is green?"
      ]
    },
    {
      "q": "What does wobbly feel like?",
      "a": "Wobbly can feel like a fluttery tummy, fidgety legs or a worried thought. It is a small feeling you can notice early.",
      "asks": [
        "Tell me about Wobbly"
      ]
    },
    {
      "q": "What do I do with big feelings?",
      "a": "Stop, take belly breaths, and use a tool, like squeezing a ball or going to the calm corner. You can say, I need help. A grown-up you trust can help.",
      "asks": [
        "Tell me about Big feelings",
        "Tell me about Tell a grown-up"
      ]
    },
    {
      "q": "Are some feelings wrong to have?",
      "a": "No. All feelings are okay. What matters is what we do with them, like using words, not hitting.",
      "asks": [
        "Is it wrong to feel angry?"
      ]
    },
    {
      "q": "Why does a feelings meter help?",
      "a": "Naming how big a feeling is helps you pick the right tool. Noticing early, at wobbly, is easiest.",
      "asks": [
        "Why use a meter?"
      ]
    }
