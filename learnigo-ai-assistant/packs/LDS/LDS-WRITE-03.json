  "faq": [
    {
      "q": "What are letter families?",
      "a": "Letter families are groups of letters that start with the same move. If you learn the move, you can write the whole family.",
      "asks": [
        "Tell me about letter families"
      ]
    },
    {
      "q": "Which letters are in the curly c family?",
      "a": "c, a, d, g, o and q all start with a curly c shape.",
      "asks": [
        "Tell me about the curly c letters"
      ]
    },
    {
      "q": "How do I write a d?",
      "a": "Draw a curly c, then go up tall, higher than the c, and come straight back down.",
      "asks": [
        "How do I write d?"
      ]
    },
    {
      "q": "Which letters are in the long line family?",
      "a": "l, i, t, j, u and y all start at the top with a line going down.",
      "asks": [
