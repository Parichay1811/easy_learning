  "faq": [
    {
      "q": "What is a picture calendar?",
      "a": "It is a calendar with a small picture for each day's big event. You can see your week at a glance, even before you read well.",
      "asks": [
        "Tell me about Swimming",
        "Why use pictures?"
      ]
    },
    {
      "q": "What if a day changes?",
      "a": "Plans change sometimes. A grown-up can move or swap the picture and tell you. Then you still know what is happening.",
      "asks": [
        "Tell me about Visit Grandma",
        "What if plans change?"
      ]
    },
    {
      "q": "Where should I put my calendar?",
      "a": "Somewhere you see every day, like by your bed, on the fridge or by the door.",
      "asks": [
        "Tell me about Rest day"
      ]
    },
    {
      "q": "How does a calendar help me feel calm?",
      "a": "When you know what is coming, there are fewer surprises. Your brain can get ready.",
      "asks": [
        "Why does it help?"
      ]
    },
    {
      "q": "Who can help me make one?",
      "a": "A grown-up you trust can help. You can draw the pictures or print them, and add a new one each week.",
      "asks": [
        "How do I make one?"
      ]
    }
