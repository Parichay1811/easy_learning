  "faq": [
    {
      "q": "What does who mean in a story?",
      "a": "Who asks about a person or an animal. In the story, Mei and Raj are the who.",
      "asks": [
        "Tell me about the who"
      ]
    },
    {
      "q": "What does what mean in a story?",
      "a": "What asks about the action, what happened. Mei fed a duck, and Raj flew a kite.",
      "asks": [
        "Tell me about the what"
      ]
    },
    {
      "q": "What does where mean in a story?",
      "a": "Where asks about the place. This story happens at the pond and in the park.",
      "asks": [
        "Tell me about the where"
      ]
    },
    {
      "q": "How do question words help me understand?",
      "a": "They help you find the most important bits of a story. If you can answer who, what and where, you know what the story is about.",
      "asks": [
        "Why ask questions when I read?"
      ]
    },
    {
      "q": "Are there other question words?",
      "a": "Yes! When asks about time, and why asks for a reason. A teacher or grown-up can help you try those too.",
      "asks": [
        "What about when and why?"
      ]
    }
