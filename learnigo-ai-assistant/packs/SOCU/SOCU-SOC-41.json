  "faq": [
    {
      "q": "What is a global citizen?",
      "a": "A global citizen is someone who understands that they are connected to people and places all over the world, and who tries to act fairly, kindly and responsibly towards them, while still belonging to their own community and country.",
      "asks": [
        "Tell me about you",
        "Global citizenship meaning"
      ]
    },
    {
      "q": "Where does chocolate come from?",
      "a": "Chocolate is made from cocoa beans, which grow on trees in hot, wet places. About 60 percent of the world's cocoa comes from Côte d'Ivoire and Ghana in West Africa.",
      "asks": [
        "Tell me about cocoa, Ghana",
        "Who grows cocoa?"
      ]
    },
    {
      "q": "Why are things made in so many countries?",
      "a": "Companies make different parts where materials, skills or costs suit best, then ship them to be put together and sold worldwide. This web is called a global supply chain.",
      "asks": [
        "Tell me about phone, China",
        "What is a supply chain?"
      ]
    },
    {
      "q": "How do my choices affect people far away?",
      "a": "What we buy, waste and burn adds to pollution and climate change, which affects farmers, coasts and cities everywhere. Our shopping also affects the pay and conditions of workers who make our things.",
      "asks": [
        "Tell me about shared air",
        "How does climate change link countries?"
      ]
    },
    {
      "q": "What is fair trade?",
      "a": "Fair trade is a system where farmers and workers are paid a fairer price and work in safer conditions. Products that meet these rules can carry a Fairtrade mark.",
      "asks": [
        "How can I buy fairly?",
        "Fairtrade meaning"
      ]
    }
  ],
