  "faq": [
    {
      "q": "Why do we say please?",
      "a": "Please shows you are asking, not ordering. It makes people feel respected, so they are happier to help.",
      "asks": [
        "Tell me about the Please"
      ]
    },
    {
      "q": "Why do we say thank you?",
      "a": "Thank you shows you noticed someone's kindness. It makes them feel good and makes you feel good too.",
      "asks": [
        "Tell me about the Thank you"
      ]
    },
    {
      "q": "When should I say excuse me?",
      "a": "When you need to pass someone, interrupt politely, get someone's attention, or after a burp or sneeze.",
      "asks": [
        "Tell me about the Excuse me"
      ]
    },
    {
      "q": "How do you say thank you in other languages?",
      "a": "Arigatou in Japanese, xièxie in Chinese, dhanyavaad in Hindi, asante in Swahili, shukran in Arabic, gracias in Spanish, obrigado or obrigada in Portuguese and merci in French.",
      "asks": [
        "Tell me about the Asia"
      ]
    },
    {
      "q": "Do I say thank you to people at shops?",
      "a": "Yes. Saying thank you to shop workers, bus drivers and cleaners shows everyone deserves respect.",
      "asks": [
        "Should I thank the bus driver?"
      ]
    }
  ],
