  "faq": [
    {
      "q": "What is a trusted adult?",
      "a": "A grown-up who listens to you, believes you, keeps you safe and helps you get help, like a parent, carer, teacher, grandparent or school counsellor.",
      "asks": [
        "Tell me about the You",
        "Tell me about the Trusted adult"
      ]
    },
    {
      "q": "What if I cannot talk to anyone I know?",
      "a": "You can call or chat with a child helpline, which is free and private, like Childline 0800 1111 in the UK or 1098 in India. Or tell a teacher or school nurse.",
      "asks": [
        "Tell me about the Child helpline"
      ]
    },
    {
      "q": "What if the adult does not believe me?",
      "a": "Tell another trusted adult, and keep telling until someone helps. You deserve to be heard.",
      "asks": [
        "Nobody listens to me"
      ]
    },
    {
      "q": "What if an adult tells me to keep a secret?",
      "a": "Safe adults do not ask children to keep secrets from their parents or carers. If anyone does, tell another trusted adult straight away.",
      "asks": [
        "Tell me about the Not a safe choice"
      ]
    },
    {
      "q": "When should I talk to a trusted adult?",
      "a": "Any time you feel scared, worried, hurt or confused, or someone is being unkind or unsafe, to you or to someone else.",
      "asks": [
        "When do I tell a grown-up?"
      ]
    }
  ],
