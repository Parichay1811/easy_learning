  "faq": [
    {
      "q": "Why is it called a safety match?",
      "a": "The phosphorus is kept on the box strip, not on the match head, so the match will not light by accident when rubbed on other surfaces.",
      "asks": [
        "What makes a safety match safe?"
      ]
    },
    {
      "q": "What is on the side of a matchbox?",
      "a": "A strip of red phosphorus mixed with powdered glass for grip and a glue to hold it on.",
      "asks": [
        "What is the striking strip made of?"
      ]
    },
    {
      "q": "What is in a match head?",
      "a": "Mainly potassium chlorate, which gives out oxygen when hot, plus sulfur as a fuel, glue and fillers.",
      "asks": [
        "What are match heads made of?"
      ]
    },
    {
      "q": "Why does a match need friction?",
      "a": "Rubbing makes enough heat to turn a little red phosphorus into white phosphorus, which catches fire in air by itself and lights the head.",
      "asks": [
        "Why do you have to strike a match?"
      ]
    },
    {
      "q": "Why do matches smell when struck?",
      "a": "The sharp smell is mostly sulfur dioxide, made as the sulfur in the match head burns.",
      "asks": [
        "What is the smell of a match?"
      ]
    }
  ],
  "facts": [
    "Safety matches using red phosphorus on the box were developed in Sweden in the 1840s and 1850s.",
    "Early matches used poisonous white phosphorus in the head, which harmed many match factory workers."
  ],
