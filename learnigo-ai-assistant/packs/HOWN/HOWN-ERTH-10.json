  "faq": [
    {
      "q": "What heats the water in a geyser?",
      "a": "Hot rock heated by magma a few kilometres below the surface. Geysers are found in volcanic areas like Yellowstone in the USA, Iceland and New Zealand.",
      "asks": [
        "Where does a geyser get its heat?",
        "Where are geysers found?"
      ]
    },
    {
      "q": "Why does the narrow vent matter?",
      "a": "The narrow vent traps the water so its weight keeps high pressure on the water below. That lets it get hotter than 100 degrees without boiling, storing up energy for an eruption.",
      "asks": [
        "Why do geysers need a narrow pipe?"
      ]
    },
    {
      "q": "Why does a geyser erupt again and again?",
      "a": "After an eruption the chamber is empty. Rainwater and groundwater seep back in, get heated again, and when the pressure balance tips, it erupts once more.",
      "asks": [
        "Why do geysers repeat?",
        "How often does Old Faithful erupt?"
      ]
    },
    {
      "q": "What is superheated water?",
      "a": "Superheated water is hotter than its normal boiling point but still liquid, because high pressure stops it boiling. When the pressure drops, it turns to steam very suddenly.",
      "asks": [
        "How can water be hotter than boiling?"
      ]
    },
    {
      "q": "What is Old Faithful?",
      "a": "Old Faithful is a famous geyser in Yellowstone National Park. It erupts about every 60 to 110 minutes, shooting water up to roughly 30 to 55 metres high.",
      "asks": [
        "Tell me about Old Faithful"
      ]
    }
  ],
  "facts": [
    "More than half of the world's geysers are in Yellowstone National Park in the USA.",
    "Old Faithful erupts roughly every 60 to 110 minutes.",
    "The word geyser comes from Geysir, a geyser in Iceland."
