  "faq": [
    {
      "q": "Where does the sediment in a delta come from?",
      "a": "It is rock worn away from mountains and land upstream, by rain, frost and the river itself, and carried down as sand, silt and mud.",
      "asks": [
        "What is a delta made of?"
      ]
    },
    {
      "q": "Why does a river drop its sediment at the sea?",
      "a": "When the river meets the still sea, it spreads out and slows down. Slower water has less energy, so it can no longer carry the sediment and drops it.",
      "asks": [
        "Why do deltas form at river mouths?"
      ]
    },
    {
      "q": "Why do rivers split into channels at a delta?",
      "a": "Dropped sediment builds banks and islands that block the main channel. The water finds new paths around them, splitting into many smaller channels called distributaries.",
      "asks": [
        "What are distributaries?"
      ]
    },
    {
      "q": "Why is delta soil so fertile?",
      "a": "The river spreads fresh silt full of nutrients across the land during floods, so delta soils are rich and good for farming, as in the Nile and Ganges deltas.",
      "asks": [
        "Why do people farm on deltas?"
      ]
    },
    {
      "q": "Why is it called a delta?",
      "a": "The Greek historian Herodotus thought the Nile's mouth looked like the triangle-shaped Greek letter delta, and the name stuck.",
      "asks": [
        "Where does the word delta come from?"
      ]
    }
  ],
  "facts": [
    "The Ganges-Brahmaputra delta in Bangladesh and India is the largest delta in the world.",
    "The name delta comes from the triangle-shaped Greek letter, after the shape of the Nile delta."
  ],
