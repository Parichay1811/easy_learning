  "faq": [
    {
      "q": "What is a lunar eclipse?",
      "a": "A lunar eclipse happens when Earth passes directly between the Sun and the full Moon, so Earth's shadow falls on the Moon. It can only happen at full Moon.",
      "asks": [
        "When do lunar eclipses happen?",
        "What causes a lunar eclipse?"
      ]
    },
    {
      "q": "Why does the Moon go red in an eclipse?",
      "a": "Sunlight passing through Earth's atmosphere is bent into Earth's shadow. The air scatters away the blue, so only red and orange light reaches the Moon and lights it up.",
      "asks": [
        "Why is an eclipsed Moon red?",
        "Why does the Moon not go black in an eclipse?"
      ]
    },
    {
      "q": "What is a blood moon?",
      "a": "Blood moon is a nickname for the Moon during a total lunar eclipse, when it glows a coppery red. The colour can range from bright orange to dark brick red.",
