  "faq": [
    {
      "q": "Why do you need two different metals?",
      "a": "The current comes from the difference between them: zinc gives up electrons more easily than copper, so electrons are pushed from the zinc, through the wire, to the copper.",
      "asks": [
        "Can you use two copper coins?"
      ]
    },
    {
      "q": "What does the lemon juice do?",
      "a": "It is the electrolyte: an acidic liquid full of charged ions that react with the zinc and carry charge between the two metals to complete the circuit.",
      "asks": [
        "Why use a lemon?"
      ]
    },
    {
      "q": "Why can't a lemon light a normal bulb?",
      "a": "One lemon cell gives only about 0.9 volts and a very tiny current. That is enough for a small LED or clock, but not a household bulb.",
      "asks": [
        "How much electricity does a lemon make?"
      ]
    },
    {
      "q": "Does the energy come from the lemon?",
      "a": "Mostly from the zinc. Zinc dissolving releases chemical energy; the lemon juice mainly provides the acid and ions that let the reaction happen.",
      "asks": [
        "Is the lemon the power source?"
      ]
    },
    {
      "q": "Can potatoes make batteries too?",
      "a": "Yes. Potatoes, apples and even salty water work with zinc and copper, because they also contain ions that can carry charge.",
      "asks": [
        "Can a potato power a clock?"
      ]
    }
