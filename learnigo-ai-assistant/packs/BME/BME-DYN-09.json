  "faq": [
    {
      "q": "What does a shock absorber do?",
      "a": "It is a damper: a piston pushes oil through small holes, which turns the energy of the bouncing into heat so the vibration dies away.",
      "asks": [
        "how does a damper work"
      ]
    },
    {
      "q": "What does underdamped mean?",
      "a": "The damping ratio is less than one. The system oscillates with swings that shrink steadily, at a frequency slightly below the natural frequency.",
      "asks": [
        "underdamped response"
      ]
    },
    {
      "q": "What is critical damping?",
      "a": "It is the smallest damping that stops oscillation completely. The system returns to rest as fast as possible without overshooting. Its value is 2 times the square root of k times m.",
      "asks": [
        "critical damping coefficient formula",
        "how do I calculate the damping ratio"
      ]
    },
    {
      "q": "What does overdamped mean?",
      "a": "The damping ratio is more than one. The system returns slowly, without overshoot, and takes longer than with critical damping.",
      "asks": [
        "overdamped response",
        "difference between underdamped and overdamped"
      ]
    },
    {
      "q": "How much damping does a car have?",
      "a": "Passenger cars are typically underdamped with a damping ratio of roughly 0.2 to 0.4, balancing comfort with keeping the tyres pressed on the road.",
      "asks": [
        "car suspension damping ratio"
      ]
    }
  ],
  "facts": [
    "The critical damping coefficient of a spring-mass system is 2 times the square root of k times m.",
    "A critically damped system returns to equilibrium in the shortest time without overshooting."
  ],
