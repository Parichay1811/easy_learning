  "faq": [
    {
      "q": "What is the Darcy-Weisbach equation?",
      "a": "It gives the friction head loss in a pipe: h f equals f times L over D times V squared over 2 g. It works for laminar and turbulent flow.",
      "asks": [
        "how do I calculate head loss in a pipe",
        "pipe friction formula"
      ]
    },
    {
      "q": "What is the friction factor in laminar flow?",
      "a": "In laminar pipe flow the Darcy friction factor is exactly 64 divided by the Reynolds number, whatever the roughness.",
      "asks": [
        "64 over Re"
      ]
    },
    {
      "q": "How do I read a Moody chart?",
      "a": "Find the Reynolds number on the bottom axis, follow it up to the curve for your relative roughness, then read the friction factor on the side. Rough pipes have higher curves that flatten out.",
      "asks": [
        "what is the Darcy friction factor",
        "Moody diagram"
      ]
    },
    {
      "q": "What is head loss?",
      "a": "Head loss is the energy lost to friction per unit weight of fluid, written as an equivalent height of fluid in metres.",
      "asks": [
        "head loss meaning"
      ]
    },
    {
      "q": "What are minor losses?",
      "a": "Extra losses at bends, valves, entries and exits, written as K times V squared over 2 g, with K taken from tables for each fitting.",
      "asks": [
        "loss coefficient K",
        "fitting losses"
      ]
    }
  ],
  "facts": [
    "In laminar pipe flow the Darcy friction factor is 64/Re.",
    "For a fixed pipe and turbulent flow, head loss rises roughly with the square of velocity."
  ],
