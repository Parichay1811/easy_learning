  "faq": [
    {
      "q": "What does the clamp spring in a clutch do?",
      "a": "It squeezes the friction plate against the flywheel. The clamp force sets how much torque the clutch can carry before it slips. Pressing the pedal releases it.",
      "asks": [
        "clutch pressure plate",
        "how does a car clutch work"
      ]
    },
    {
      "q": "How do I calculate clutch torque?",
      "a": "Torque equals mu times clamp force times the number of friction faces times the mean radius. With uniform wear the mean radius is the average of the outer and inner radii.",
      "asks": [
        "friction plate torque formula",
        "what does the friction plate do"
      ]
    },
    {
      "q": "What happens while a clutch is slipping?",
      "a": "The two sides turn at different speeds, the friction torque speeds one up and slows the other, and the energy lost in slipping becomes heat in the linings until the speeds match.",
      "asks": [
        "clutch engagement",
        "clutch slip heat"
      ]
    },
    {
      "q": "Where does the energy go when a car brakes?",
      "a": "Friction brakes turn the kinetic energy into heat in the discs and pads, which then cools into the air. A 1500 kilogram car stopping from 100 kilometres per hour releases about 579 kilojoules.",
      "asks": [
        "brake energy calculation"
      ]
    },
    {
      "q": "What is the uniform wear assumption?",
      "a": "Once a clutch has bedded in, wear is taken as even across the lining, which makes pressure times radius constant. It gives a slightly lower, safer torque than the uniform pressure assumption.",
      "asks": [
        "uniform wear vs uniform pressure"
      ]
    }
  ],
  "facts": [
    "A single-plate clutch has two friction faces.",
    "Stopping a 1500 kg car from 100 km/h releases about 579 kJ of kinetic energy as heat."
  ],
