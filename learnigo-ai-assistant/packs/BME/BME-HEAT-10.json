  "faq": [
    {
      "q": "What is relative humidity?",
      "a": "Relative humidity is the water vapour pressure in the air divided by the most it could hold at that temperature, given as a percentage.",
      "asks": [
        "RH meaning"
      ]
    },
    {
      "q": "What is the saturation curve?",
      "a": "The curve on a psychrometric chart showing the most water vapour air can hold at each temperature. Air on it is at 100 percent relative humidity.",
      "asks": [
        "psychrometric chart saturation line"
      ]
    },
    {
      "q": "How does an air conditioner remove humidity?",
      "a": "Its cooling coil chills the air below its dew point, so some water vapour condenses on the coil and drains away. The air leaves cooler and drier.",
      "asks": [
        "dehumidification",
        "cooling coil"
      ]
    },
    {
      "q": "What is the dew point?",
      "a": "The temperature at which air becomes saturated if cooled without changing its water content. Below it, water condenses as dew or mist.",
      "asks": [
        "dew point meaning"
      ]
    },
    {
      "q": "What is the humidity ratio?",
      "a": "The mass of water vapour per kilogram of dry air, often given in grams per kilogram. It stays the same when air is heated or cooled without condensation.",
      "asks": [
        "specific humidity",
        "moisture content"
      ]
    }
  ],
  "facts": [
    "Air at 30 °C can hold about 27 g of water vapour per kg of dry air; at 0 °C under 4 g.",
    "Cooling air below its dew point makes water condense out of it."
  ],
