  "faq": [
    {
      "q": "What is the Reynolds number?",
      "a": "Re equals rho V D over mu, the ratio of inertia forces to viscous forces. It has no units and tells you whether a flow will be laminar or turbulent.",
      "asks": [
        "Reynolds number formula",
        "Reynolds number meaning"
      ]
    },
    {
      "q": "What does the laminar velocity profile look like?",
      "a": "In laminar pipe flow the speed varies as a parabola across the pipe: zero at the wall and fastest in the middle, at twice the mean speed.",
      "asks": [
        "parabolic velocity profile"
      ]
    },
    {
      "q": "What does the turbulent velocity profile look like?",
      "a": "It is much flatter across the middle because eddies mix the flow, then drops steeply to zero in a thin layer at the wall.",
      "asks": [
        "turbulent velocity profile",
        "one seventh power law"
      ]
    },
    {
      "q": "When does pipe flow become turbulent?",
      "a": "In a round pipe the flow is usually laminar below a Reynolds number of about 2300 and turbulent above about 4000, with a transition region in between.",
      "asks": [
        "critical Reynolds number"
      ]
    },
    {
      "q": "What is the difference between laminar and turbulent flow?",
      "a": "Laminar flow moves in smooth layers that do not mix. Turbulent flow is full of swirling eddies that mix the fluid and raise friction.",
      "asks": [
        "laminar vs turbulent"
      ]
    }
  ],
  "facts": [
    "Osborne Reynolds published his dye experiments on pipe flow in 1883.",
    "In laminar pipe flow the centreline speed is twice the mean speed."
