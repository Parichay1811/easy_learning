  "faq": [
    {
      "q": "What is an isothermal process?",
      "a": "A process at constant temperature. For an ideal gas, P V stays constant, and the heat added equals the work done, because the internal energy does not change.",
      "asks": [
        "constant temperature process"
      ]
    },
    {
      "q": "What is an adiabatic process?",
      "a": "A process with no heat transfer, either because it is insulated or too fast for heat to flow. For a reversible adiabatic ideal gas, P V to the power gamma is constant.",
      "asks": [
        "difference between isothermal and adiabatic",
        "why is the adiabatic curve steeper"
      ]
    },
    {
      "q": "What is an isobaric process?",
      "a": "A process at constant pressure. The work done is P times the change in volume, and the heat added equals the change in enthalpy.",
      "asks": [
        "constant pressure process"
      ]
    },
    {
      "q": "What is an isochoric process?",
      "a": "A process at constant volume. No boundary work is done, so all the heat added goes into internal energy.",
      "asks": [
        "constant volume process"
      ]
    },
    {
      "q": "What is a polytropic process?",
      "a": "A process following P V to the n equals constant. Choosing n gives the special cases: 0 isobaric, 1 isothermal, gamma adiabatic and infinity isochoric.",
      "asks": [
        "polytropic index"
      ]
    }
  ],
  "facts": [
    "For a reversible adiabatic process of an ideal gas, P V to the power gamma is constant; gamma is about 1.4 for air.",
    "In an isothermal process of an ideal gas, the heat added equals the work done."
