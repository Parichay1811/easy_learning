  "faq": [
    {
      "q": "What does Bernoulli's equation say?",
      "a": "Along a streamline in steady, frictionless, incompressible flow, pressure plus half rho V squared plus rho g h is constant. It is conservation of energy per unit volume.",
      "asks": [
        "Bernoulli equation meaning",
        "Bernoulli principle"
      ]
    },
    {
      "q": "What is static pressure?",
      "a": "Static pressure is the pressure you would feel moving with the fluid, the one a gauge on the pipe wall reads.",
      "asks": [
        "static pressure meaning"
      ]
    },
    {
      "q": "What is dynamic pressure?",
      "a": "Dynamic pressure is half rho V squared: the kinetic energy of the fluid per cubic metre. Water at 8 metres per second has 32 kilopascals of it.",
      "asks": [
        "half rho v squared"
      ]
    },
    {
      "q": "Why does the pressure drop in the throat?",
      "a": "The fluid must speed up to get through the narrow throat, and the push that speeds it up comes from higher pressure behind. So pressure falls where velocity rises.",
      "asks": [
        "why does pressure drop when fluid speeds up"
      ]
    },
    {
      "q": "How does a venturi meter work?",
      "a": "It narrows the pipe to a throat and measures the pressure drop. From Bernoulli and continuity, that drop gives the velocity and hence the flow rate.",
      "asks": [
        "venturi meter flow measurement"
      ]
    }
  ],
  "facts": [
    "Daniel Bernoulli published his work on fluid flow, Hydrodynamica, in 1738.",
    "Water flowing at 8 m/s has a dynamic pressure of 32 kPa."
  ],
