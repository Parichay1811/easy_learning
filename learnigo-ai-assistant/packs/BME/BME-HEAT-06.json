  "faq": [
    {
      "q": "What happens in a parallel flow heat exchanger?",
      "a": "Both fluids enter at the same end and flow the same way. The temperature gap is large at the inlet and shrinks along the length, so the cold outlet can never exceed the hot outlet.",
      "asks": [
        "parallel flow heat exchanger"
      ]
    },
    {
      "q": "Why is counter flow more efficient?",
      "a": "The fluids flow in opposite directions, so the temperature gap stays more even along the length. That gives a bigger mean driving difference, so less area is needed, and the cold fluid can leave hotter than the hot fluid leaves.",
      "asks": [
        "counter flow heat exchanger",
        "what is the difference between parallel and counter flow heat exchangers"
      ]
    },
    {
      "q": "How do I calculate the LMTD?",
      "a": "Find the temperature gap at each end, delta T1 and delta T2. LMTD equals delta T1 minus delta T2 divided by the natural log of delta T1 over delta T2.",
      "asks": [
        "log mean temperature difference formula"
      ]
    },
    {
      "q": "What is the overall heat transfer coefficient U?",
      "a": "U combines the convection on both sides and the conduction through the wall into one coefficient, so Q equals U A LMTD. It is one over the total resistance per square metre.",
      "asks": [
        "U value heat exchanger"
      ]
    },
    {
      "q": "How do I size a heat exchanger?",
      "a": "Find the duty Q from m times c p times the temperature change of one fluid, work out the LMTD, then the area is Q divided by U times LMTD.",
      "asks": [
        "heat exchanger area calculation"
      ]
    }
  ],
  "facts": [
    "For the same end temperatures, counter flow always has a larger LMTD than parallel flow.",
    "Only in counter flow can the cold fluid leave hotter than the hot fluid leaves."
  ],
