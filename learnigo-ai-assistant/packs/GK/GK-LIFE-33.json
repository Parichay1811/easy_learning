  "faq": [
    {
      "q": "How does parcel tracking work?",
      "a": "Each parcel has a barcode with a unique number. Every time it is scanned at a hub, depot or van, the place and time are saved to a computer, which updates your tracking page.",
      "asks": [
        "How do they know where my parcel is?"
      ]
    },
    {
      "q": "What is on a parcel's barcode label?",
      "a": "A unique tracking number, plus the delivery address and type of service. The barcode lets machines read the number in a split second.",
      "asks": [
        "What does a tracking number mean?"
      ]
    },
    {
      "q": "How does the driver prove delivery?",
      "a": "The driver scans the parcel at your door and may take a photo or a signature. This last scan marks it as delivered.",
      "asks": [
        "Why did the driver take a photo of my parcel?"
      ]
    },
    {
      "q": "Does a tracked parcel have GPS inside?",
      "a": "Usually not. Tracking comes from barcode scans along the way. Some delivery vans have GPS, so a few services can show the van moving on a map.",
      "asks": [
        "Is there a GPS tracker in my parcel?"
      ]
    },
    {
      "q": "Why does my parcel stay in one place for days?",
      "a": "Tracking only updates at each scan. While a parcel travels a long way, by ship or plane, there may be no scans for a while.",
      "asks": [
        "Why hasn't my tracking updated?"
      ]
    }
  ],
