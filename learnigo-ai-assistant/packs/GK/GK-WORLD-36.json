  "faq": [
    {
      "q": "Who was Ibn Battuta?",
      "a": "Ibn Battuta was a Muslim scholar from Tangier, Morocco, born in 1304. He travelled for about 30 years across Africa, Asia and Europe and described it all in a famous book, the Rihla.",
      "asks": [
        "Where was Ibn Battuta from?"
      ]
    },
    {
      "q": "What did Ibn Battuta do in Delhi?",
      "a": "The sultan of Delhi, Muhammad bin Tughluq, made him a qadi, a judge. He lived in India for about eight years.",
      "asks": [
        "Did Ibn Battuta go to India?"
      ]
    },
    {
      "q": "Did Ibn Battuta visit Mali?",
      "a": "Yes. In 1352 he crossed the Sahara with a camel caravan and visited the Mali Empire, including Timbuktu.",
      "asks": [
        "Did Ibn Battuta go to Timbuktu?"
      ]
    },
    {
      "q": "How far did Ibn Battuta travel?",
      "a": "About 117,000 kilometres, much farther than most travellers of his time, about three times around the Earth.",
      "asks": [
        "How many countries did Ibn Battuta visit?"
      ]
    },
    {
      "q": "What is the Rihla?",
      "a": "Rihla means journey. Back home, Ibn Battuta told his stories to a writer named Ibn Juzayy, who wrote them down around 1355.",
      "asks": [
        "Did Ibn Battuta write a book?"
      ]
    }
  ],
  "facts": [
    "Ibn Battuta left Tangier in 1325 and travelled for about 29 years.",
    "His travels, the Rihla, were written down by Ibn Juzayy around 1355."
