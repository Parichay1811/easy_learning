  "faq": [
    {
      "q": "Where does tap water come from?",
      "a": "From rivers, lakes and reservoirs, or from groundwater pumped up from wells and boreholes. Different towns use different sources.",
      "asks": [
        "Where does my water come from?"
      ]
    },
    {
      "q": "How is water cleaned before it reaches my tap?",
      "a": "At a treatment works, screens remove rubbish, chemicals clump dirt together so it sinks, sand filters catch tiny bits, and a little chlorine or ultraviolet light kills germs.",
      "asks": [
        "How is drinking water made safe?"
      ]
    },
    {
      "q": "Why do towns use water towers?",
      "a": "Pumps fill a tall tower or hilltop tank, and gravity then pushes the water through the pipes with steady pressure, even while the pumps rest.",
      "asks": [
        "What is a water tower for?"
      ]
    },
    {
      "q": "Where does water go after the plughole?",
      "a": "Into the sewers, which carry it to a sewage works. There it is cleaned and then released back into a river or the sea.",
      "asks": [
        "Where does toilet water go?"
      ]
    },
    {
      "q": "Is tap water safe to drink everywhere?",
      "a": "Not everywhere. In many countries it's tested and safe, but in some places it needs boiling or filtering first. Over 2 billion people still lack safely managed drinking water at home.",
      "asks": [
        "Can I drink tap water in every country?"
      ]
    }
  ],
  "facts": [
    "Small amounts of chlorine are widely used to kill germs in drinking water.",
    "According to WHO and UNICEF, over 2 billion people lacked safely managed drinking water in 2022."
  ],
