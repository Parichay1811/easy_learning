  "faq": [
    {
      "q": "Who invented paper?",
      "a": "Paper was first made in China over 2,000 years ago. In 105 CE an official named Cai Lun improved it and reported it to the emperor, so he is often called its inventor.",
      "asks": [
        "Who was Cai Lun?"
      ]
    },
    {
      "q": "How did paper reach Europe?",
      "a": "It travelled west along trade routes from China to Samarkand, Baghdad and Cairo, then across North Africa to Spain, where paper mills began in the 1100s.",
      "asks": [
        "When did Europe get paper?"
      ]
    },
    {
      "q": "When did paper come to Baghdad?",
      "a": "Baghdad had a paper mill by 794. Cheap paper helped the city become a great centre of books and learning.",
      "asks": [
        "Why was paper important in Baghdad?"
      ]
    },
    {
      "q": "What did people write on before paper?",
      "a": "Clay tablets, papyrus made from reeds in Egypt, palm leaves in India, bamboo strips and silk in China, and parchment made from animal skin in Europe.",
      "asks": [
        "What was used before paper?"
      ]
    },
    {
      "q": "How was the first paper made?",
      "a": "Plant fibres like bark, hemp and old rags were soaked and pounded into mush, spread on a screen, pressed and dried into thin sheets.",
      "asks": [
        "What was the first paper made from?"
      ]
    }
