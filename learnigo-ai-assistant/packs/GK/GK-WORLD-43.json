  "faq": [
    {
      "q": "What is a seismoscope?",
      "a": "A seismoscope is a device that shows an earthquake has happened. Zhang Heng's, built in 132 CE, is the first one we know of.",
      "asks": [
        "Who made the first earthquake detector?"
      ]
    },
    {
      "q": "How did Zhang Heng's seismoscope work?",
      "a": "Most scientists think a heavy pendulum inside swung when the ground shook, pushing a lever that opened one dragon's mouth. A ball dropped into a toad below, showing the direction of the quake.",
      "asks": [
        "How did the dragon jar work?"
      ]
    },
    {
      "q": "Who was Zhang Heng?",
      "a": "Zhang Heng, who lived from 78 to 139 CE in Han dynasty China, was an astronomer, mathematician, inventor, mapmaker and poet.",
      "asks": [
        "What else did Zhang Heng invent?"
      ]
    },
    {
      "q": "Did Zhang Heng's seismoscope really work?",
      "a": "Records say that in 138 CE it detected an earthquake in Longxi, hundreds of kilometres away, days before a messenger brought the news.",
      "asks": [
        "Did the dragon jar detect real earthquakes?"
      ]
    },
    {
      "q": "What is a pendulum?",
      "a": "A weight hanging from a fixed point that can swing freely. Because it is heavy, it tends to stay still when its support suddenly moves.",
      "asks": [
        "Why does a pendulum swing?"
      ]
    }
  ],
  "facts": [
    "Zhang Heng built his seismoscope in 132 CE during the Han dynasty.",
    "It had eight dragons facing eight directions, each above a bronze toad."
