  "faq": [
    {
      "q": "How did the Persian Empire rule so many peoples?",
      "a": "Through a mix of central control and local freedom: satraps governed provinces and collected tribute, inspectors and roads kept the king informed, and local religions, laws and elites were often left in place.",
      "asks": [
        "How did the Achaemenids govern?",
        "Who was the Great King?"
      ]
    },
    {
      "q": "What was a satrapy?",
      "a": "A province of the Persian Empire governed by a satrap, who collected tribute and kept order for the king. Herodotus lists about twenty satrapies under Darius I.",
      "asks": [
        "What did a satrap do?"
      ]
    },
    {
      "q": "What was the Royal Road?",
      "a": "A highway of about 2,700 kilometres from Sardis to Susa, with relay stations where royal messengers changed horses. Messages could cross it in about a week instead of three months on foot.",
      "asks": [
        "How long was the Persian Royal Road?"
      ]
    },
    {
      "q": "What is the Cyrus Cylinder?",
      "a": "A clay cylinder from about 539 BCE, written in Babylonian cuneiform, praising Cyrus's conquest of Babylon and describing the return of deported peoples and gods. It is in the British Museum.",
      "asks": [
        "Was the Cyrus Cylinder a human rights charter?"
      ]
    },
    {
      "q": "Why do historians distrust Greek sources on Persia?",
      "a": "Writers like Herodotus were from Persia's enemies and wrote after the Persian Wars, so they often painted Persians as luxurious and despotic. Persian inscriptions and administrative tablets give a different, more practical picture.",
      "asks": [
        "What are the sources for Achaemenid history?"
      ]
    }
