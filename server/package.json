{
  "name": "easy-learn",
  "version": "1.0.0",
  "description": "This helps dyslexic children to learn things in a easier way",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed:all": "node scripts/seed-all.js",
    "test:ai-assistant": "npm --prefix ai-assistant test",
    "test": "node --test --test-force-exit \"test/*.test.js\" \"test/integration/*.test.js\""
  },
  "engines": {
    "node": ">=20.11"
  },
  "keywords": [
    "dyslexia",
    "children",
    "learning"
  ],
  "author": "Sutirtha Chakraborty",
  "license": "ISC",
  "dependencies": {
    "@huggingface/transformers": "3.8.1",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^1.41.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "exceljs": "^4.4.0",
    "express": "^4.21.0",
    "express-validator": "^7.3.2",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^7.2.0",
    "mongoose": "^8.10.0",
    "multer": "^2.2.0",
    "multer-storage-cloudinary": "^4.0.0",
    "node-llama-cpp": "^3.22.3",
    "nodemon": "^3.1.14",
    "onnxruntime-node": "1.21.0",
    "yt-search-lib": "^1.3.0"
  },
  "optionalDependencies": {
    "kokoro-js": "1.2.1"
  },
  "allowScripts": {
    "onnxruntime-node@1.21.0": true,
    "node-llama-cpp@3.22.3": true,
    "sharp@0.34.5": true,
    "protobufjs@7.6.6": true
  },
  "nodemonConfig": {
    "ignore": [
      "uploads/",
      "data/_translations_wip/",
      "ai-assistant/data/",
      "ai-assistant/packs/",
      "ai-assistant/public/",
      "ai-assistant/factory/",
      "ai-assistant/test/"
    ]
  },
  "devDependencies": {
    "mongodb-memory-server": "^10.4.3"
  }
}
