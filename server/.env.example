# Express API (and the AI voice assistant inside it). Copy to server/.env.
# Production values: see DEPLOY.md §6.
PORT=5001
# Origins allowed to call the API (comma-separated), e.g. the Vite dev server.
CLIENT_URL=https://localhost:5173,http://localhost:5173

# Main app DB (students)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/mydb
JWT_SECRET=<long-random-string>
JWT_EXPIRES_IN=7d

# Admin DB (org admins + tutors/teachers) and super-admin DB
ADMIN_MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/admindb
SUPERADMIN_MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/superadmindb

ADMIN_JWT_SECRET=<long-random-string>
ADMIN_JWT_EXPIRES_IN=7d
SUPERADMIN_JWT_SECRET=<long-random-string>
SUPERADMIN_JWT_EXPIRES_IN=1d
TEACHER_JWT_SECRET=<long-random-string>
TEACHER_JWT_EXPIRES_IN=7d
PARENT_JWT_SECRET=<long-random-string>
PARENT_JWT_EXPIRES_IN=7d

SUPER_ADMIN_EMAIL=<email>
SUPER_ADMIN_PASSWORD=<strong-password>

CLOUDINARY_CLOUD_NAME=<cloud-name>
CLOUDINARY_API_KEY=<api-key>
CLOUDINARY_API_SECRET=<api-secret>

# AI voice assistant (server/ai-assistant). Its models (~1.2 GB) download to
# ~/.cache/learnigo-teacher on first start. All optional; see
# server/ai-assistant/README.md "Settings".
# AI_ASSISTANT=off              # leave the assistant out of this API entirely
# AI_ASSISTANT_PROFILE=small    # small|full; default: small on <=2 CPUs or <6 GB RAM
#                               # (browser voice, no LLM, typed questions)
# LT_LLM=off                    # no language model (rules and lesson packs only)

# --- Added with the roles work (all optional unless noted) ---
# Signs the student session cookie. Falls back to JWT_SECRET when unset.
COOKIE_SECRET=
# Firebase project id used to verify Google sign-in tokens (defaults to the public project id).
FIREBASE_PROJECT_ID=
# Email: without SMTP, messages are kept in the Outbox collection (visible to the super admin).
SMTP_URL=
MAIL_FROM=Learnigo <no-reply@learnigo.eu>
# Set to off to disable the weekly digests / scheduled jobs.
SCHEDULER=on
