  "faq": [
    {
      "q": "What are the primary colours?",
      "a": "In paint, the traditional primary colours are red, yellow and blue. They cannot be mixed from other paints, and they mix to make many other colours.",
      "asks": [
        "Which colours are primary?",
        "Why are red yellow and blue primary?"
      ]
    },
    {
      "q": "What are secondary colours?",
      "a": "Secondary colours are made by mixing two primary colours: red and yellow make orange, yellow and blue make green, and blue and red make violet, or purple.",
      "asks": [
        "How do you make secondary colours?",
        "Is green a secondary colour?"
      ]
    },
    {
      "q": "What are tertiary colours?",
      "a": "Tertiary colours are made by mixing a primary colour with the secondary colour next to it, such as red-orange, yellow-green or blue-violet. The wheel then has 12 colours.",
      "asks": [
        "What is a tertiary colour?",
        "How many colours on a 12-part colour wheel?"
      ]
    },
    {
      "q": "What are complementary colours?",
      "a": "Complementary colours sit opposite each other on the colour wheel: red and green, blue and orange, yellow and violet. Next to each other they look extra bright and bold.",
      "asks": [
        "What colour is opposite blue?",
        "Why do opposite colours stand out?"
      ]
    },
    {
      "q": "Who made the first colour wheel?",
      "a": "Isaac Newton published one of the first colour circles in his book Opticks in 1704, bending the colours of the rainbow into a circle.",
      "asks": [
        "When was the colour wheel invented?",
        "Did Newton invent the colour wheel?"
      ]
    }
  ],
