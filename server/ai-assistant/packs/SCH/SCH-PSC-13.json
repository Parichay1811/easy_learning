  "faq": [
    {
      "q": "How do people grow up?",
      "a": "People go through stages: baby, toddler, child, teenager, adult and older adult. Each stage brings new skills and body changes.",
      "asks": [
        "What are the stages of human life?"
      ]
    },
    {
      "q": "What is a toddler?",
      "a": "A toddler is a young child from about one to three years old who is learning to walk steadily and to talk.",
      "asks": [
        "Why are toddlers called toddlers?"
      ]
    },
    {
      "q": "Why do teenagers grow so fast?",
      "a": "Around the teenage years, the body makes growth chemicals called hormones that cause a growth spurt and change a child's body into an adult body. This is called puberty.",
      "asks": [
        "What is a growth spurt?"
      ]
    },
    {
      "q": "Why do children lose their baby teeth?",
      "a": "Baby teeth are small to fit a small mouth. As the jaw grows, adult teeth push up underneath. The roots of the baby teeth wear away, and the baby teeth fall out.",
      "asks": [
        "Why do baby teeth fall out?"
      ]
    },
    {
      "q": "When do people stop growing taller?",
      "a": "Most people stop growing taller in their late teens, often between about 15 and 19 years old, when the growth zones in their bones close.",
      "asks": [
        "How long do you keep growing?"
      ]
    }
