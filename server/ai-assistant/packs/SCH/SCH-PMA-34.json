    },
    {
      "q": "How long is a ruler?",
      "a": "A standard school ruler is 30 centimetres long. Some short rulers are 15 centimetres.",
      "asks": [
        "How many centimetres is a ruler?"
      ]
    },
    {
      "q": "How many centimetres are in a metre?",
      "a": "There are 100 centimetres in 1 metre. A metre is about as tall as a 4-year-old child.",
      "asks": [
        "How long is a metre?"
      ]
    },
    {
      "q": "Why do we start at 0 and not 1?",
      "a": "The 0 mark is the very start of the length. If you start at 1, you miss the first centimetre, and your answer is 1 too big.",
      "asks": [
        "Do I start measuring from 1?"
      ]
    },
    {
      "q": "When should I use metres instead of centimetres?",
      "a": "Use centimetres for small things like a pencil or a book. Use metres for big things like a room, a door or a swimming pool.",
      "asks": [
        "Centimetres or metres?"
      ]
    }
