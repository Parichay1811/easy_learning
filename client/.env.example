# Firebase — get these from your Firebase project console
VITE_FIREBASE_API_KEY=your_firebase_api_key_here

# Where the client sends API requests.
# Local dev:  http://localhost:5000/api
# Production: https://www.learnigo.eu/api
VITE_API_BASE_URL=http://localhost:5000/api

# The learnigo-ai-assistant "live teacher" app (learnigo-ai-assistant/ at the
# repo root) runs as its own server, embedded on the Home page in an iframe.
# Local dev:  http://localhost:4173 (its default — `npm start` inside that folder)
# Production: https://assistant.learnigo.eu (see DEPLOY.md)
VITE_AI_ASSISTANT_URL=http://localhost:4173
